// A program in several files.
//
// A module is one file. Its name is its path from the folder of the
// program's entry file (this one), with dots: zoo/animals.lum is the module
// zoo.animals. Folders only group modules.
//
// A module shares what it declares with 'pub'; the rest stays private.

import zoo.animals;                // use as animals.name
import zoo.keeper.{Keeper, hire};  // use the names directly
import zoo.feed as food;           // use under another name

fn main() -> Int {
    let cat = animals.new("cat", 4);
    let owl = animals.new("owl", 1);
    let inhabitants: [animals.Animal] = [cat, owl];

    let sam: Keeper = hire("Sam");

    for animal in inhabitants {
        println(sam.feed(animal, food.portion(animal)));
    }

    println(
        sam.name,
        "fed",
        sam.fed,
        "animals;",
        animals.heaviest(inhabitants).name,
        "is the heaviest",
    );

    return 0;
}
