// A task, and how it is written to and read from a file.

import std.json;
import std.json.{Json};
import std.result.{Result};
import std.time;
import std.time.{Date};
import std.strings;

pub enum Priority { Low, Normal, High }

impl Priority {
    pub fn name() -> String {
        return match self {
            case Priority.Low: "low";
            case Priority.Normal: "normal";
            case Priority.High: "high";
        };
    }

    // Higher first when sorting.
    pub fn rank() -> Int {
        return match self {
            case Priority.High: 0;
            case Priority.Normal: 1;
            case Priority.Low: 2;
        };
    }
}

pub fn priorityOf(name: String) -> Priority? {
    return match strings.lower(name) {
        case "low": Priority.Low;
        case "normal": Priority.Normal;
        case "high": Priority.High;
        default: null;
    };
}

pub enum State {
    Open,
    Done(Date),         // when it was finished
}

pub struct Task {
    id: Int;
    title: String;
    priority: Priority;
    due: Date?;
    state: State;
}

impl Task {
    pub fn isOpen() -> Bool { return self.state == State.Open; }

    // Whether it should have been finished before `today`.
    pub fn isLate(today: Date) -> Bool {
        let due = self.due;
        return self.isOpen() && due != null && due.daysUntil(today) > 0;
    }

    // "today", "in 3 days", "2 days late", or "" without a date.
    pub fn deadline(today: Date) -> String {
        let due = self.due;
        if due == null { return ""; }
        let days = today.daysUntil(due);
        if days == 0 { return "today"; }
        if days == 1 { return "tomorrow"; }
        if days > 1 { return "in ${days} days"; }
        if days == -1 { return "1 day late"; }
        return "${-days} days late";
    }

    pub fn toJson() -> Json {
        let out = json.object().int("id", self.id).text("title", self.title).text("priority", self.priority.name());
        let due = self.due;
        if due != null { out.text("due", due.iso()); }
        match self.state {
            case State.Open: { }
            case State.Done(when): { out.text("done", when.iso()); }
        }
        return out.done();
    }
}

// The task a document describes, or what is wrong with the document.
pub fn fromJson(document: Json) -> Result<Task, String> {
    let id = document.get("id")?.int();
    if id == null { return Result.Err("a task needs a whole number as its id"); }
    let title = document.get("title")?.text();
    if title == null { return Result.Err("task ${id} has no title"); }

    let priority = Priority.Normal;
    let named = document.get("priority")?.text();
    if named != null {
        let known = priorityOf(named);
        if known == null { return Result.Err("task ${id} has the priority '${named}', which is not low, normal or high"); }
        priority = known;
    }

    let due: Date? = null;
    let dueText = document.get("due")?.text();
    if dueText != null {
        due = time.parse(dueText);
        if due == null { return Result.Err("task ${id} is due on '${dueText}', which is not a date"); }
    }

    let state = State.Open;
    let doneText = document.get("done")?.text();
    if doneText != null {
        let when = time.parse(doneText);
        if when == null { return Result.Err("task ${id} was done on '${doneText}', which is not a date"); }
        state = State.Done(when);
    }
    return Result.Ok(Task { id: id, title: title, priority: priority, due: due, state: state });
}
