// The list of tasks, kept in a file as JSON.

import std.io;
import std.io.{ErrorKind};
import std.json;
import std.json.{Json};
import std.result.{Result};
import std.arrays;
import todo.task;
import todo.task.{Task};

// What can go wrong between the program and its file. Each case keeps
// the error it came from: nothing is lost by passing it up.
pub enum StoreError {
    File(io.Error),             // the file cannot be read or written
    NotJson(json.ParseError),   // someone edited it by hand, and slipped
    NotTasks(String),           // it is JSON, of something else
}

impl StoreError {
    pub fn describe() -> String {
        return match self {
            case StoreError.File(error): error.describe();
            case StoreError.NotJson(error): "the list is damaged at ${error.describe()}";
            case StoreError.NotTasks(why): "the list is damaged: ${why}";
        };
    }
}

pub struct Store {
    file: String;
    tasks: [Task];
}

// Opens the list kept in a file. A file that is not there yet is an
// empty list, not a failure: that is how a first run looks.
pub fn open(file: String) -> Result<Store, StoreError> {
    match io.readFile(file) {
        case Result.Ok(text): {
            return read(text).map(fn(tasks: [Task]) -> Store { return Store { file: file, tasks: tasks }; });
        }
        case Result.Err(error): {
            if error.kind == ErrorKind.NotFound { return Result.Ok(Store { file: file, tasks: [] }); }
            return Result.Err(StoreError.File(error));
        }
    }
}

fn read(text: String) -> Result<[Task], StoreError> {
    return fromDocument(json.parse(text).mapErr(StoreError.NotJson)?);
}

fn fromDocument(document: Json) -> Result<[Task], StoreError> {
    let items = document.items();
    if items == null { return Result.Err(StoreError.NotTasks("expected an array of tasks")); }
    let tasks: [Task] = [];
    for item in items {
        // The first task that cannot be read ends it, with its reason
        push(tasks, task.fromJson(item).mapErr(StoreError.NotTasks)?);
    }
    return Result.Ok(tasks);
}

impl Store {
    pub fn save() -> Result<Int, StoreError> {
        let document = json.array(self.tasks, t -> t.toJson());
        return io.writeFile(self.file, document.pretty() + "\n").mapErr(StoreError.File);
    }

    // One more than the highest id in use: ids are never given twice,
    // even after a task is removed from the middle.
    pub fn nextId() -> Int {
        return (arrays.largest(arrays.map(self.tasks, t -> t.id)) ?? 0) + 1;
    }

    pub fn find(id: Int) -> Task? {
        return arrays.find(self.tasks, t -> t.id == id);
    }

    pub fn add(new: Task) {
        push(self.tasks, new);
    }

    // Returns whether there was such a task.
    pub fn remove(id: Int) -> Bool {
        let at = arrays.findIndex(self.tasks, t -> t.id == id);
        if at == null { return false; }
        self.tasks = arrays.without(self.tasks, at);
        return true;
    }
}
