// When things go wrong.
//
// A failure that is part of the job is returned: the function gives a
// Result, which holds the value or the reason there is none, and whoever
// calls it has to look.
//
// A failure that should never happen stops the program: an index that is
// not there, or a call of `panic`. `attempt` is for the places that must
// survive those anyway, such as a loop that runs jobs one after another.
//
// Shows: Result, an error type of your own with a trace, panic, attempt,
// std.io errors with their kind.

import std.io.{ErrorKind};
import std.result.{Kind, Location, attempt};

// --- An error of our own, saying what and where ---

enum Reason { Empty, NotANumber(String), OutOfRange(Int) }

struct ConfigError {
    key: String;
    reason: Reason;
    stack: [Location];  // where it was found
}

impl ConfigError {
    fn describe() -> String {
        return match self.reason {
            case Reason.Empty: "${self.key} is empty";
            case Reason.NotANumber(text): "${self.key} should be a number, not '${text}'";
            case Reason.OutOfRange(n): "${self.key} should be from 1 to 100, not ${n}";
        };
    }
}

fn invalid(key: String, reason: Reason) -> ConfigError {
    // stack(1): from whoever called this function, not from here
    return ConfigError { key: key, reason: reason, stack: result.stack(1) };
}

// --- Functions that can fail return a Result ---

fn number(key: String, text: String) -> Result<Int, ConfigError> {
    if text.isBlank() {
        return Err(invalid(key, Reason.Empty));
    }

    let n = text.parseInt();

    if n == null {
        return Err(invalid(key, Reason.NotANumber(text)));
    }

    return Ok(n);
}

fn percent(key: String, text: String) -> Result<Int, ConfigError> {
    // A next step that can fail too; the first failure is the one that comes out
    return number(key, text).then(fn(n: Int) -> Result<Int, ConfigError> {
        if n < 1 || n > 100 {
            return Err(invalid(key, Reason.OutOfRange(n)));
        }

        return Ok(n);
    });
}

// --- Jobs that may stop the program ---

fn average(numbers: [Int]) -> Int {
    return numbers.sum() / numbers.len();
}

fn third(numbers: [Int]) -> Int {
    return numbers[2];
}

fn checked(n: Int) -> Int {
    if n < 0 {
        panic("a negative total:", n);
    }

    return n;
}

fn main() -> Int {
    println("-- settings");

    for text in ["40", "", "lots", "250"] {
        match percent("volume", text) {
            case Ok(n): {
                println("volume set to ${n}");
            }

            case Err(error): {
                println("refused: ${error.describe()}");
            }
        }
    }

    // An error is a value: it can be kept, passed on, asked where it came from
    let error = percent("brightness", "x").reason();

    if error != null {
        println(result.trace(error.describe(), error.stack));
    }

    println("-- files");

    match io.readFile("no-such-file.conf") {
        case Ok(text): {
            println(text.len(), "characters");
        }

        case Err(problem): {
            match problem.kind {
                case ErrorKind.NotFound: {
                    println("no settings file; using the defaults");
                }

                default: {
                    println(problem.describe());
                }
            }
        }
    }

    // Or in one line, when the reason does not matter
    println(io.readFileLines("no-such-file.conf").orElse([]).len(), "lines");

    println("-- jobs");

    let jobs: [fn() -> Int] = [
        fn() -> Int {
            return average([4, 8, 9]);
        },
        fn() -> Int {
            return average([]);
        },
        fn() -> Int {
            return third([1, 2]);
        },
        fn() -> Int {
            return checked(3 - 10);
        },
        fn() -> Int {
            return average([10, 20]);
        },
    ];

    let completed = 0;

    for i, job in jobs {
        // Without attempt, the second job would end the program
        match attempt(job) {
            case Ok(n): {
                println("job ${i} gave ${n}");
                completed++;
            }

            case Err(failure): {
                match failure.kind {
                    case Kind.Panic: {
                        println("job ${i} gave up: ${failure.message}");
                    }

                    default: {
                        println("job ${i} broke: ${failure.message} in ${failure.at.function}");
                    }
                }
            }
        }
    }

    println("${completed} of ${jobs.len()} jobs completed");
    return 0;
}
