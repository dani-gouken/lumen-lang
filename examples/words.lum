// Counting the words of a text, with the standard library.
//
// The library is built into lumen: `import std.strings;` works in any
// program, nothing to install. See docs/stdlib.md for all of it.
//
// Shows: std.strings to take a text apart, std.dict to count, std.arrays to
// sort and summarize, std.math for the numbers, std.list for a table.

import std.arrays;
import std.list;
import std.dict;
import std.math;
import std.strings;

struct Count {
    word: String;
    times: Int;
}

// The words of a text in lower case, without the punctuation around them.
fn wordsOf(text: String) -> [String] {
    let out: [String] = [];

    for raw in text.lower().words() {
        let word = raw;

        for mark in [",", ".", ";", ":", "!", "?", "\""] {
            word = word.replace(mark, "");
        }

        if !word.isEmpty() {
            out.push(word);
        }
    }

    return out;
}

fn main() -> Int {
    let text = "It was the best of times, it was the worst of times, it was the age of wisdom, it was the age of foolishness, it was the epoch of belief, it was the epoch of incredulity, it was the season of Light, it was the season of Darkness.";

    let words = wordsOf(text);

    // A map from each word to how often it occurs
    let counts = dict.empty<Int>();

    for word in words {
        counts.set(word, (counts.get(word) ?? 0) + 1);
    }

    // As a list of structs, most frequent first; ties in alphabetical order
    let table = list.empty<Count>();

    for word in counts.keys().sortedTexts() {
        table.add(Count { word: word, times: counts.get(word) ?? 0 });
    }

    table.sort((a, b) -> a.times > b.times);

    println(words.len(), "words,", counts.size(), "different");
    println();

    for row in table.slice(0, 6).toArray() {
        println(row.word.padRight(8), toString(row.times).padLeft(3), "#".repeat(row.times));
    }

    // Numbers about the words
    let lengths = words.map(w -> w.len());
    let average = lengths.sum().toFloat() / lengths.len().toFloat();
    println();
    println("average length:", (average * 100.0).round().toFloat() / 100.0);
    let byLength = counts.keys().sorted((a, b) -> a.len() > b.len());
    println("longest:", byLength[0]);

    let once = table.filter(row -> row.times == 1);
    println("used once:", once.map<String>(row -> row.word).toArray().join(", "));

    // Taking a sentence apart and putting it back differently
    let first = text.first(text.indexOf(",") ?? text.len());
    println(first.words().reversed().join(" "));
    println(first.words().map(text -> text.capitalize()).join(" "));
    return 0;
}
