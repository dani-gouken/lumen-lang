// raylib, for Lumen: every function, struct and constant of raylib.h.
//
// Written by generate.py from the header of raylib 5.5; change that, not this.
//
//   import raylib;
//
//   raylib.InitWindow(800, 450, "hello");
//   while !raylib.WindowShouldClose() {
//       raylib.BeginDrawing();
//       raylib.ClearBackground(raylib.rayWhite());
//       raylib.DrawText("hello from Lumen", 190, 200, 20, raylib.darkGray());
//       raylib.EndDrawing();
//   }
//   raylib.CloseWindow();
//
// The names are those of C, so what is written about raylib anywhere
// applies. The types are those of C too: an Int32 is an Int to the
// program, a Float32 a Float, a CString a String. A Pointer is an address,
// an Int: see std.ffi for the functions that want one. A struct is passed
// and returned by value, as raylib does.
//
// The library is found by its name: libraylib.dylib or libraylib.so, in
// the usual places or in a folder listed in LUMEN_LIBRARY_PATH.

// --- Structs ---

// Vector2, 2 components
pub extern struct Vector2 {
    x: Float32;
    y: Float32;
}

// Vector3, 3 components
pub extern struct Vector3 {
    x: Float32;
    y: Float32;
    z: Float32;
}

// Vector4, 4 components
pub extern struct Vector4 {
    x: Float32;
    y: Float32;
    z: Float32;
    w: Float32;
}

// Matrix, 4x4 components, column major, OpenGL style, right-handed
pub extern struct Matrix {
    m0: Float32;
    m4: Float32;
    m8: Float32;
    m12: Float32;
    m1: Float32;
    m5: Float32;
    m9: Float32;
    m13: Float32;
    m2: Float32;
    m6: Float32;
    m10: Float32;
    m14: Float32;
    m3: Float32;
    m7: Float32;
    m11: Float32;
    m15: Float32;
}

// Color, 4 components, R8G8B8A8 (32bit)
pub extern struct Color {
    r: UInt8;
    g: UInt8;
    b: UInt8;
    a: UInt8;
}

// Rectangle, 4 components
pub extern struct Rectangle {
    x: Float32;
    y: Float32;
    width: Float32;
    height: Float32;
}

// Image, pixel data stored in CPU memory (RAM)
pub extern struct Image {
    data: Pointer;
    width: Int32;
    height: Int32;
    mipmaps: Int32;
    format: Int32;
}

// Texture, tex data stored in GPU memory (VRAM)
pub extern struct Texture {
    id: UInt32;
    width: Int32;
    height: Int32;
    mipmaps: Int32;
    format: Int32;
}

// RenderTexture, fbo for texture rendering
pub extern struct RenderTexture {
    id: UInt32;
    texture: Texture;
    depth: Texture;
}

// NPatchInfo, n-patch layout info
pub extern struct NPatchInfo {
    source: Rectangle;
    left: Int32;
    top: Int32;
    right: Int32;
    bottom: Int32;
    layout: Int32;
}

// GlyphInfo, font characters glyphs info
pub extern struct GlyphInfo {
    value: Int32;
    offsetX: Int32;
    offsetY: Int32;
    advanceX: Int32;
    image: Image;
}

// Font, font texture and GlyphInfo array data
pub extern struct Font {
    baseSize: Int32;
    glyphCount: Int32;
    glyphPadding: Int32;
    texture: Texture;
    recs: Pointer;
    glyphs: Pointer;
}

// Camera, defines position/orientation in 3d space
pub extern struct Camera3D {
    position: Vector3;
    target: Vector3;
    up: Vector3;
    fovy: Float32;
    projection: Int32;
}

// Camera2D, defines position/orientation in 2d space
pub extern struct Camera2D {
    offset: Vector2;
    target: Vector2;
    rotation: Float32;
    zoom: Float32;
}

// Mesh, vertex data and vao/vbo
pub extern struct Mesh {
    vertexCount: Int32;
    triangleCount: Int32;
    vertices: Pointer;
    texcoords: Pointer;
    texcoords2: Pointer;
    normals: Pointer;
    tangents: Pointer;
    colors: Pointer;
    indices: Pointer;
    animVertices: Pointer;
    animNormals: Pointer;
    boneIds: Pointer;
    boneWeights: Pointer;
    boneMatrices: Pointer;
    boneCount: Int32;
    vaoId: UInt32;
    vboId: Pointer;
}

// Shader
pub extern struct Shader {
    id: UInt32;
    locs: Pointer;
}

// MaterialMap
pub extern struct MaterialMap {
    texture: Texture;
    color: Color;
    value: Float32;
}

// Material, includes shader and maps
pub extern struct Material {
    shader: Shader;
    maps: Pointer;
    params0: Float32;
    params1: Float32;
    params2: Float32;
    params3: Float32;
}

// Transform, vertex transformation data
pub extern struct Transform {
    translation: Vector3;
    rotation: Vector4;
    scale: Vector3;
}

// Bone, skeletal animation bone
pub extern struct BoneInfo {
    name0: Int8;
    name1: Int8;
    name2: Int8;
    name3: Int8;
    name4: Int8;
    name5: Int8;
    name6: Int8;
    name7: Int8;
    name8: Int8;
    name9: Int8;
    name10: Int8;
    name11: Int8;
    name12: Int8;
    name13: Int8;
    name14: Int8;
    name15: Int8;
    name16: Int8;
    name17: Int8;
    name18: Int8;
    name19: Int8;
    name20: Int8;
    name21: Int8;
    name22: Int8;
    name23: Int8;
    name24: Int8;
    name25: Int8;
    name26: Int8;
    name27: Int8;
    name28: Int8;
    name29: Int8;
    name30: Int8;
    name31: Int8;
    parent: Int32;
}

// Model, meshes, materials and animation data
pub extern struct Model {
    transform: Matrix;
    meshCount: Int32;
    materialCount: Int32;
    meshes: Pointer;
    materials: Pointer;
    meshMaterial: Pointer;
    boneCount: Int32;
    bones: Pointer;
    bindPose: Pointer;
}

// ModelAnimation
pub extern struct ModelAnimation {
    boneCount: Int32;
    frameCount: Int32;
    bones: Pointer;
    framePoses: Pointer;
    name0: Int8;
    name1: Int8;
    name2: Int8;
    name3: Int8;
    name4: Int8;
    name5: Int8;
    name6: Int8;
    name7: Int8;
    name8: Int8;
    name9: Int8;
    name10: Int8;
    name11: Int8;
    name12: Int8;
    name13: Int8;
    name14: Int8;
    name15: Int8;
    name16: Int8;
    name17: Int8;
    name18: Int8;
    name19: Int8;
    name20: Int8;
    name21: Int8;
    name22: Int8;
    name23: Int8;
    name24: Int8;
    name25: Int8;
    name26: Int8;
    name27: Int8;
    name28: Int8;
    name29: Int8;
    name30: Int8;
    name31: Int8;
}

// Ray, ray for raycasting
pub extern struct Ray {
    position: Vector3;
    direction: Vector3;
}

// RayCollision, ray hit information
pub extern struct RayCollision {
    hit: Bool;
    distance: Float32;
    point: Vector3;
    normal: Vector3;
}

// BoundingBox
pub extern struct BoundingBox {
    min: Vector3;
    max: Vector3;
}

// Wave, audio wave data
pub extern struct Wave {
    frameCount: UInt32;
    sampleRate: UInt32;
    sampleSize: UInt32;
    channels: UInt32;
    data: Pointer;
}

// AudioStream, custom audio stream
pub extern struct AudioStream {
    buffer: Pointer;
    processor: Pointer;
    sampleRate: UInt32;
    sampleSize: UInt32;
    channels: UInt32;
}

// Sound
pub extern struct Sound {
    stream: AudioStream;
    frameCount: UInt32;
}

// Music, audio stream, anything longer than ~10 seconds should be streamed
pub extern struct Music {
    stream: AudioStream;
    frameCount: UInt32;
    looping: Bool;
    ctxType: Int32;
    ctxData: Pointer;
}

// VrDeviceInfo, Head-Mounted-Display device parameters
pub extern struct VrDeviceInfo {
    hResolution: Int32;
    vResolution: Int32;
    hScreenSize: Float32;
    vScreenSize: Float32;
    eyeToScreenDistance: Float32;
    lensSeparationDistance: Float32;
    interpupillaryDistance: Float32;
    lensDistortionValues0: Float32;
    lensDistortionValues1: Float32;
    lensDistortionValues2: Float32;
    lensDistortionValues3: Float32;
    chromaAbCorrection0: Float32;
    chromaAbCorrection1: Float32;
    chromaAbCorrection2: Float32;
    chromaAbCorrection3: Float32;
}

// VrStereoConfig, VR stereo rendering configuration for simulator
pub extern struct VrStereoConfig {
    projection0: Matrix;
    projection1: Matrix;
    viewOffset0: Matrix;
    viewOffset1: Matrix;
    leftLensCenter0: Float32;
    leftLensCenter1: Float32;
    rightLensCenter0: Float32;
    rightLensCenter1: Float32;
    leftScreenCenter0: Float32;
    leftScreenCenter1: Float32;
    rightScreenCenter0: Float32;
    rightScreenCenter1: Float32;
    scale0: Float32;
    scale1: Float32;
    scaleIn0: Float32;
    scaleIn1: Float32;
}

// File path list
pub extern struct FilePathList {
    capacity: UInt32;
    count: UInt32;
    paths: Pointer;
}

// Automation event
pub extern struct AutomationEvent {
    frame: UInt32;
    type: UInt32;
    params0: Int32;
    params1: Int32;
    params2: Int32;
    params3: Int32;
}

// Automation event list
pub extern struct AutomationEventList {
    capacity: UInt32;
    count: UInt32;
    events: Pointer;
}

// Quaternion is another name of Vector4 in C: use Vector4.
// Texture2D is another name of Texture in C: use Texture.
// TextureCubemap is another name of Texture in C: use Texture.
// RenderTexture2D is another name of RenderTexture in C: use RenderTexture.
// Camera is another name of Camera3D in C: use Camera3D.

// --- Colors ---

// LIGHTGRAY: Light Gray
pub fn lightGray() -> Color { return Color { r: 200, g: 200, b: 200, a: 255 }; }
// GRAY: Gray
pub fn gray() -> Color { return Color { r: 130, g: 130, b: 130, a: 255 }; }
// DARKGRAY: Dark Gray
pub fn darkGray() -> Color { return Color { r: 80, g: 80, b: 80, a: 255 }; }
// YELLOW: Yellow
pub fn yellow() -> Color { return Color { r: 253, g: 249, b: 0, a: 255 }; }
// GOLD: Gold
pub fn gold() -> Color { return Color { r: 255, g: 203, b: 0, a: 255 }; }
// ORANGE: Orange
pub fn orange() -> Color { return Color { r: 255, g: 161, b: 0, a: 255 }; }
// PINK: Pink
pub fn pink() -> Color { return Color { r: 255, g: 109, b: 194, a: 255 }; }
// RED: Red
pub fn red() -> Color { return Color { r: 230, g: 41, b: 55, a: 255 }; }
// MAROON: Maroon
pub fn maroon() -> Color { return Color { r: 190, g: 33, b: 55, a: 255 }; }
// GREEN: Green
pub fn green() -> Color { return Color { r: 0, g: 228, b: 48, a: 255 }; }
// LIME: Lime
pub fn lime() -> Color { return Color { r: 0, g: 158, b: 47, a: 255 }; }
// DARKGREEN: Dark Green
pub fn darkGreen() -> Color { return Color { r: 0, g: 117, b: 44, a: 255 }; }
// SKYBLUE: Sky Blue
pub fn skyBlue() -> Color { return Color { r: 102, g: 191, b: 255, a: 255 }; }
// BLUE: Blue
pub fn blue() -> Color { return Color { r: 0, g: 121, b: 241, a: 255 }; }
// DARKBLUE: Dark Blue
pub fn darkBlue() -> Color { return Color { r: 0, g: 82, b: 172, a: 255 }; }
// PURPLE: Purple
pub fn purple() -> Color { return Color { r: 200, g: 122, b: 255, a: 255 }; }
// VIOLET: Violet
pub fn violet() -> Color { return Color { r: 135, g: 60, b: 190, a: 255 }; }
// DARKPURPLE: Dark Purple
pub fn darkPurple() -> Color { return Color { r: 112, g: 31, b: 126, a: 255 }; }
// BEIGE: Beige
pub fn beige() -> Color { return Color { r: 211, g: 176, b: 131, a: 255 }; }
// BROWN: Brown
pub fn brown() -> Color { return Color { r: 127, g: 106, b: 79, a: 255 }; }
// DARKBROWN: Dark Brown
pub fn darkBrown() -> Color { return Color { r: 76, g: 63, b: 47, a: 255 }; }
// WHITE: White
pub fn white() -> Color { return Color { r: 255, g: 255, b: 255, a: 255 }; }
// BLACK: Black
pub fn black() -> Color { return Color { r: 0, g: 0, b: 0, a: 255 }; }
// BLANK: Blank (Transparent)
pub fn blank() -> Color { return Color { r: 0, g: 0, b: 0, a: 0 }; }
// MAGENTA: Magenta
pub fn magenta() -> Color { return Color { r: 255, g: 0, b: 255, a: 255 }; }
// RAYWHITE: My own White (raylib logo)
pub fn rayWhite() -> Color { return Color { r: 245, g: 245, b: 245, a: 255 }; }

// --- Constants ---

// ConfigFlags: By default all flags are set to 0
pub const FLAG_VSYNC_HINT = 64;  // Set to try enabling V-Sync on GPU
pub const FLAG_FULLSCREEN_MODE = 2;  // Set to run program in fullscreen
pub const FLAG_WINDOW_RESIZABLE = 4;  // Set to allow resizable window
pub const FLAG_WINDOW_UNDECORATED = 8;  // Set to disable window decoration (frame and buttons)
pub const FLAG_WINDOW_HIDDEN = 128;  // Set to hide window
pub const FLAG_WINDOW_MINIMIZED = 512;  // Set to minimize window (iconify)
pub const FLAG_WINDOW_MAXIMIZED = 1024;  // Set to maximize window (expanded to monitor)
pub const FLAG_WINDOW_UNFOCUSED = 2048;  // Set to window non focused
pub const FLAG_WINDOW_TOPMOST = 4096;  // Set to window always on top
pub const FLAG_WINDOW_ALWAYS_RUN = 256;  // Set to allow windows running while minimized
pub const FLAG_WINDOW_TRANSPARENT = 16;  // Set to allow transparent framebuffer
pub const FLAG_WINDOW_HIGHDPI = 8192;  // Set to support HighDPI
pub const FLAG_WINDOW_MOUSE_PASSTHROUGH = 16384;  // Set to support mouse passthrough, only supported when FLAG_WINDOW_UNDECORATED
pub const FLAG_BORDERLESS_WINDOWED_MODE = 32768;  // Set to run program in borderless windowed mode
pub const FLAG_MSAA_4X_HINT = 32;  // Set to try enabling MSAA 4X
pub const FLAG_INTERLACED_HINT = 65536;  // Set to try enabling interlaced video format (for V3D)

// TraceLogLevel: NOTE: Organized by priority level
pub const LOG_ALL = 0;  // Display all logs
pub const LOG_TRACE = 1;  // Trace logging, intended for internal use only
pub const LOG_DEBUG = 2;  // Debug logging, used for internal debugging, it should be disabled on release builds
pub const LOG_INFO = 3;  // Info logging, used for program execution info
pub const LOG_WARNING = 4;  // Warning logging, used on recoverable failures
pub const LOG_ERROR = 5;  // Error logging, used on unrecoverable failures
pub const LOG_FATAL = 6;  // Fatal logging, used to abort program: exit(EXIT_FAILURE)
pub const LOG_NONE = 7;  // Disable logging

