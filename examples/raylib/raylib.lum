// Mesh generation functions

// Generate polygonal mesh
pub extern "raylib" fn GenMeshPoly(sides: Int32, radius: Float32) -> Mesh;
// Generate plane mesh (with subdivisions)
pub extern "raylib" fn GenMeshPlane(width: Float32, length: Float32, resX: Int32, resZ: Int32) -> Mesh;
// Generate cuboid mesh
pub extern "raylib" fn GenMeshCube(width: Float32, height: Float32, length: Float32) -> Mesh;
// Generate sphere mesh (standard sphere)
pub extern "raylib" fn GenMeshSphere(radius: Float32, rings: Int32, slices: Int32) -> Mesh;
// Generate half-sphere mesh (no bottom cap)
pub extern "raylib" fn GenMeshHemiSphere(radius: Float32, rings: Int32, slices: Int32) -> Mesh;
// Generate cylinder mesh
pub extern "raylib" fn GenMeshCylinder(radius: Float32, height: Float32, slices: Int32) -> Mesh;
// Generate cone/pyramid mesh
pub extern "raylib" fn GenMeshCone(radius: Float32, height: Float32, slices: Int32) -> Mesh;
// Generate torus mesh
pub extern "raylib" fn GenMeshTorus(radius: Float32, size: Float32, radSeg: Int32, sides: Int32) -> Mesh;
// Generate trefoil knot mesh
pub extern "raylib" fn GenMeshKnot(radius: Float32, size: Float32, radSeg: Int32, sides: Int32) -> Mesh;
// Generate heightmap mesh from image data
pub extern "raylib" fn GenMeshHeightmap(heightmap: Image, size: Vector3) -> Mesh;
// Generate cubes-based map mesh from image data
pub extern "raylib" fn GenMeshCubicmap(cubicmap: Image, cubeSize: Vector3) -> Mesh;

// Material loading/unloading functions

// Load materials from model file
pub extern "raylib" fn LoadMaterials(fileName: CString, materialCount: Pointer) -> Pointer;
// Load default material (Supports: DIFFUSE, SPECULAR, NORMAL maps)
pub extern "raylib" fn LoadMaterialDefault() -> Material;
// Check if a material is valid (shader assigned, map textures loaded in GPU)
pub extern "raylib" fn IsMaterialValid(material: Material) -> Bool;
// Unload material from GPU memory (VRAM)
pub extern "raylib" fn UnloadMaterial(material: Material);
// Set texture for a material map type (MATERIAL_MAP_DIFFUSE, MATERIAL_MAP_SPECULAR...)
pub extern "raylib" fn SetMaterialTexture(material: Pointer, mapType: Int32, texture: Texture);
// Set material for a mesh
pub extern "raylib" fn SetModelMeshMaterial(model: Pointer, meshId: Int32, materialId: Int32);

// Model animations loading/unloading functions

// Load model animations from file
pub extern "raylib" fn LoadModelAnimations(fileName: CString, animCount: Pointer) -> Pointer;
// Update model animation pose (CPU)
pub extern "raylib" fn UpdateModelAnimation(model: Model, anim: ModelAnimation, frame: Int32);
// Update model animation mesh bone matrices (GPU skinning)
pub extern "raylib" fn UpdateModelAnimationBones(model: Model, anim: ModelAnimation, frame: Int32);
// Unload animation data
pub extern "raylib" fn UnloadModelAnimation(anim: ModelAnimation);
// Unload animation array data
pub extern "raylib" fn UnloadModelAnimations(animations: Pointer, animCount: Int32);
// Check model animation skeleton match
pub extern "raylib" fn IsModelAnimationValid(model: Model, anim: ModelAnimation) -> Bool;

// Collision detection functions

// Check collision between two spheres
pub extern "raylib" fn CheckCollisionSpheres(center1: Vector3, radius1: Float32, center2: Vector3, radius2: Float32) -> Bool;
// Check collision between two bounding boxes
pub extern "raylib" fn CheckCollisionBoxes(box1: BoundingBox, box2: BoundingBox) -> Bool;
// Check collision between box and sphere
pub extern "raylib" fn CheckCollisionBoxSphere(box: BoundingBox, center: Vector3, radius: Float32) -> Bool;
// Get collision info between ray and sphere
pub extern "raylib" fn GetRayCollisionSphere(ray: Ray, center: Vector3, radius: Float32) -> RayCollision;
// Get collision info between ray and box
pub extern "raylib" fn GetRayCollisionBox(ray: Ray, box: BoundingBox) -> RayCollision;
// Get collision info between ray and mesh
pub extern "raylib" fn GetRayCollisionMesh(ray: Ray, mesh: Mesh, transform: Matrix) -> RayCollision;
// Get collision info between ray and triangle
pub extern "raylib" fn GetRayCollisionTriangle(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3) -> RayCollision;
// Get collision info between ray and quad
pub extern "raylib" fn GetRayCollisionQuad(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3, p4: Vector3) -> RayCollision;

// Audio Loading and Playing Functions (Module: audio)

// Audio device management functions

// Initialize audio device and context
pub extern "raylib" fn InitAudioDevice();
// Close the audio device and context
pub extern "raylib" fn CloseAudioDevice();
// Check if audio device has been initialized successfully
pub extern "raylib" fn IsAudioDeviceReady() -> Bool;
// Set master volume (listener)
pub extern "raylib" fn SetMasterVolume(volume: Float32);
// Get master volume (listener)
pub extern "raylib" fn GetMasterVolume() -> Float32;

// Wave/Sound loading/unloading functions

// Load wave data from file
pub extern "raylib" fn LoadWave(fileName: CString) -> Wave;
// Load wave from memory buffer, fileType refers to extension: i.e. '.wav'
pub extern "raylib" fn LoadWaveFromMemory(fileType: CString, fileData: Pointer, dataSize: Int32) -> Wave;
// Checks if wave data is valid (data loaded and parameters)
pub extern "raylib" fn IsWaveValid(wave: Wave) -> Bool;
// Load sound from file
pub extern "raylib" fn LoadSound(fileName: CString) -> Sound;
// Load sound from wave data
pub extern "raylib" fn LoadSoundFromWave(wave: Wave) -> Sound;
// Create a new sound that shares the same sample data as the source sound, does not own the sound data
pub extern "raylib" fn LoadSoundAlias(source: Sound) -> Sound;
// Checks if a sound is valid (data loaded and buffers initialized)
pub extern "raylib" fn IsSoundValid(sound: Sound) -> Bool;
// Update sound buffer with new data
pub extern "raylib" fn UpdateSound(sound: Sound, data: Pointer, sampleCount: Int32);
// Unload wave data
pub extern "raylib" fn UnloadWave(wave: Wave);
// Unload sound
pub extern "raylib" fn UnloadSound(sound: Sound);
// Unload a sound alias (does not deallocate sample data)
pub extern "raylib" fn UnloadSoundAlias(alias: Sound);
// Export wave data to file, returns true on success
pub extern "raylib" fn ExportWave(wave: Wave, fileName: CString) -> Bool;
// Export wave sample data to code (.h), returns true on success
pub extern "raylib" fn ExportWaveAsCode(wave: Wave, fileName: CString) -> Bool;

// Wave/Sound management functions

// Play a sound
pub extern "raylib" fn PlaySound(sound: Sound);
// Stop playing a sound
pub extern "raylib" fn StopSound(sound: Sound);
// Pause a sound
pub extern "raylib" fn PauseSound(sound: Sound);
// Resume a paused sound
pub extern "raylib" fn ResumeSound(sound: Sound);
// Check if a sound is currently playing
pub extern "raylib" fn IsSoundPlaying(sound: Sound) -> Bool;
// Set volume for a sound (1.0 is max level)
pub extern "raylib" fn SetSoundVolume(sound: Sound, volume: Float32);
// Set pitch for a sound (1.0 is base level)
pub extern "raylib" fn SetSoundPitch(sound: Sound, pitch: Float32);
// Set pan for a sound (0.5 is center)
pub extern "raylib" fn SetSoundPan(sound: Sound, pan: Float32);
// Copy a wave to a new wave
pub extern "raylib" fn WaveCopy(wave: Wave) -> Wave;
// Crop a wave to defined frames range
pub extern "raylib" fn WaveCrop(wave: Pointer, initFrame: Int32, finalFrame: Int32);
// Convert wave data to desired format
pub extern "raylib" fn WaveFormat(wave: Pointer, sampleRate: Int32, sampleSize: Int32, channels: Int32);
// Load samples data from wave as a 32bit float data array
pub extern "raylib" fn LoadWaveSamples(wave: Wave) -> Pointer;
// Unload samples data loaded with LoadWaveSamples()
pub extern "raylib" fn UnloadWaveSamples(samples: Pointer);

// Music management functions

// Load music stream from file
pub extern "raylib" fn LoadMusicStream(fileName: CString) -> Music;
// Load music stream from data
pub extern "raylib" fn LoadMusicStreamFromMemory(fileType: CString, data: Pointer, dataSize: Int32) -> Music;
// Checks if a music stream is valid (context and buffers initialized)
pub extern "raylib" fn IsMusicValid(music: Music) -> Bool;
// Unload music stream
pub extern "raylib" fn UnloadMusicStream(music: Music);
// Start music playing
pub extern "raylib" fn PlayMusicStream(music: Music);
// Check if music is playing
pub extern "raylib" fn IsMusicStreamPlaying(music: Music) -> Bool;
// Updates buffers for music streaming
pub extern "raylib" fn UpdateMusicStream(music: Music);
// Stop music playing
pub extern "raylib" fn StopMusicStream(music: Music);
// Pause music playing
pub extern "raylib" fn PauseMusicStream(music: Music);
// Resume playing paused music
pub extern "raylib" fn ResumeMusicStream(music: Music);
// Seek music to a position (in seconds)
pub extern "raylib" fn SeekMusicStream(music: Music, position: Float32);
// Set volume for music (1.0 is max level)
pub extern "raylib" fn SetMusicVolume(music: Music, volume: Float32);
// Set pitch for a music (1.0 is base level)
pub extern "raylib" fn SetMusicPitch(music: Music, pitch: Float32);
// Set pan for a music (0.5 is center)
pub extern "raylib" fn SetMusicPan(music: Music, pan: Float32);
// Get music time length (in seconds)
pub extern "raylib" fn GetMusicTimeLength(music: Music) -> Float32;
// Get current music time played (in seconds)
pub extern "raylib" fn GetMusicTimePlayed(music: Music) -> Float32;

// AudioStream management functions

// Load audio stream (to stream raw audio pcm data)
pub extern "raylib" fn LoadAudioStream(sampleRate: UInt32, sampleSize: UInt32, channels: UInt32) -> AudioStream;
// Checks if an audio stream is valid (buffers initialized)
pub extern "raylib" fn IsAudioStreamValid(stream: AudioStream) -> Bool;
// Unload audio stream and free memory
pub extern "raylib" fn UnloadAudioStream(stream: AudioStream);
// Update audio stream buffers with data
pub extern "raylib" fn UpdateAudioStream(stream: AudioStream, data: Pointer, frameCount: Int32);
// Check if any audio stream buffers requires refill
pub extern "raylib" fn IsAudioStreamProcessed(stream: AudioStream) -> Bool;
// Play audio stream
pub extern "raylib" fn PlayAudioStream(stream: AudioStream);
// Pause audio stream
pub extern "raylib" fn PauseAudioStream(stream: AudioStream);
// Resume audio stream
pub extern "raylib" fn ResumeAudioStream(stream: AudioStream);
// Check if audio stream is playing
pub extern "raylib" fn IsAudioStreamPlaying(stream: AudioStream) -> Bool;
// Stop audio stream
pub extern "raylib" fn StopAudioStream(stream: AudioStream);
// Set volume for audio stream (1.0 is max level)
pub extern "raylib" fn SetAudioStreamVolume(stream: AudioStream, volume: Float32);
// Set pitch for audio stream (1.0 is base level)
pub extern "raylib" fn SetAudioStreamPitch(stream: AudioStream, pitch: Float32);
// Set pan for audio stream (0.5 is centered)
pub extern "raylib" fn SetAudioStreamPan(stream: AudioStream, pan: Float32);
// Default size for new audio streams
pub extern "raylib" fn SetAudioStreamBufferSizeDefault(size: Int32);

