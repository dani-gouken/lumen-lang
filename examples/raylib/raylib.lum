// MouseButton: Mouse buttons
pub const MOUSE_BUTTON_LEFT = 0;  // Mouse button left
pub const MOUSE_BUTTON_RIGHT = 1;  // Mouse button right
pub const MOUSE_BUTTON_MIDDLE = 2;  // Mouse button middle (pressed wheel)
pub const MOUSE_BUTTON_SIDE = 3;  // Mouse button side (advanced mouse device)
pub const MOUSE_BUTTON_EXTRA = 4;  // Mouse button extra (advanced mouse device)
pub const MOUSE_BUTTON_FORWARD = 5;  // Mouse button forward (advanced mouse device)
pub const MOUSE_BUTTON_BACK = 6;  // Mouse button back (advanced mouse device)

// MouseCursor: Mouse cursor
pub const MOUSE_CURSOR_DEFAULT = 0;  // Default pointer shape
pub const MOUSE_CURSOR_ARROW = 1;  // Arrow shape
pub const MOUSE_CURSOR_IBEAM = 2;  // Text writing cursor shape
pub const MOUSE_CURSOR_CROSSHAIR = 3;  // Cross shape
pub const MOUSE_CURSOR_POINTING_HAND = 4;  // Pointing hand cursor
pub const MOUSE_CURSOR_RESIZE_EW = 5;  // Horizontal resize/move arrow shape
pub const MOUSE_CURSOR_RESIZE_NS = 6;  // Vertical resize/move arrow shape
pub const MOUSE_CURSOR_RESIZE_NWSE = 7;  // Top-left to bottom-right diagonal resize/move arrow shape
pub const MOUSE_CURSOR_RESIZE_NESW = 8;  // The top-right to bottom-left diagonal resize/move arrow shape
pub const MOUSE_CURSOR_RESIZE_ALL = 9;  // The omnidirectional resize/move cursor shape
pub const MOUSE_CURSOR_NOT_ALLOWED = 10;  // The operation-not-allowed shape

// GamepadButton: Gamepad buttons
pub const GAMEPAD_BUTTON_UNKNOWN = 0;  // Unknown button, just for error checking
pub const GAMEPAD_BUTTON_LEFT_FACE_UP = 1;  // Gamepad left DPAD up button
pub const GAMEPAD_BUTTON_LEFT_FACE_RIGHT = 2;  // Gamepad left DPAD right button
pub const GAMEPAD_BUTTON_LEFT_FACE_DOWN = 3;  // Gamepad left DPAD down button
pub const GAMEPAD_BUTTON_LEFT_FACE_LEFT = 4;  // Gamepad left DPAD left button
pub const GAMEPAD_BUTTON_RIGHT_FACE_UP = 5;  // Gamepad right button up (i.e. PS3: Triangle, Xbox: Y)
pub const GAMEPAD_BUTTON_RIGHT_FACE_RIGHT = 6;  // Gamepad right button right (i.e. PS3: Circle, Xbox: B)
pub const GAMEPAD_BUTTON_RIGHT_FACE_DOWN = 7;  // Gamepad right button down (i.e. PS3: Cross, Xbox: A)
pub const GAMEPAD_BUTTON_RIGHT_FACE_LEFT = 8;  // Gamepad right button left (i.e. PS3: Square, Xbox: X)
pub const GAMEPAD_BUTTON_LEFT_TRIGGER_1 = 9;  // Gamepad top/back trigger left (first), it could be a trailing button
pub const GAMEPAD_BUTTON_LEFT_TRIGGER_2 = 10;  // Gamepad top/back trigger left (second), it could be a trailing button
pub const GAMEPAD_BUTTON_RIGHT_TRIGGER_1 = 11;  // Gamepad top/back trigger right (first), it could be a trailing button
pub const GAMEPAD_BUTTON_RIGHT_TRIGGER_2 = 12;  // Gamepad top/back trigger right (second), it could be a trailing button
pub const GAMEPAD_BUTTON_MIDDLE_LEFT = 13;  // Gamepad center buttons, left one (i.e. PS3: Select)
pub const GAMEPAD_BUTTON_MIDDLE = 14;  // Gamepad center buttons, middle one (i.e. PS3: PS, Xbox: XBOX)
pub const GAMEPAD_BUTTON_MIDDLE_RIGHT = 15;  // Gamepad center buttons, right one (i.e. PS3: Start)
pub const GAMEPAD_BUTTON_LEFT_THUMB = 16;  // Gamepad joystick pressed button left
pub const GAMEPAD_BUTTON_RIGHT_THUMB = 17;  // Gamepad joystick pressed button right

// GamepadAxis: Gamepad axis
pub const GAMEPAD_AXIS_LEFT_X = 0;  // Gamepad left stick X axis
pub const GAMEPAD_AXIS_LEFT_Y = 1;  // Gamepad left stick Y axis
pub const GAMEPAD_AXIS_RIGHT_X = 2;  // Gamepad right stick X axis
pub const GAMEPAD_AXIS_RIGHT_Y = 3;  // Gamepad right stick Y axis
pub const GAMEPAD_AXIS_LEFT_TRIGGER = 4;  // Gamepad back trigger left, pressure level: [1..-1]
pub const GAMEPAD_AXIS_RIGHT_TRIGGER = 5;  // Gamepad back trigger right, pressure level: [1..-1]

// MaterialMapIndex: Material map index
pub const MATERIAL_MAP_ALBEDO = 0;  // Albedo material (same as: MATERIAL_MAP_DIFFUSE)
pub const MATERIAL_MAP_METALNESS = 1;  // Metalness material (same as: MATERIAL_MAP_SPECULAR)
pub const MATERIAL_MAP_NORMAL = 2;  // Normal material
pub const MATERIAL_MAP_ROUGHNESS = 3;  // Roughness material
pub const MATERIAL_MAP_OCCLUSION = 4;  // Ambient occlusion material
pub const MATERIAL_MAP_EMISSION = 5;  // Emission material
pub const MATERIAL_MAP_HEIGHT = 6;  // Heightmap material
pub const MATERIAL_MAP_CUBEMAP = 7;  // Cubemap material (NOTE: Uses GL_TEXTURE_CUBE_MAP)
pub const MATERIAL_MAP_IRRADIANCE = 8;  // Irradiance material (NOTE: Uses GL_TEXTURE_CUBE_MAP)
pub const MATERIAL_MAP_PREFILTER = 9;  // Prefilter material (NOTE: Uses GL_TEXTURE_CUBE_MAP)
pub const MATERIAL_MAP_BRDF = 10;  // Brdf material

// ShaderLocationIndex: Shader location index
pub const SHADER_LOC_VERTEX_POSITION = 0;  // Shader location: vertex attribute: position
pub const SHADER_LOC_VERTEX_TEXCOORD01 = 1;  // Shader location: vertex attribute: texcoord01
pub const SHADER_LOC_VERTEX_TEXCOORD02 = 2;  // Shader location: vertex attribute: texcoord02
pub const SHADER_LOC_VERTEX_NORMAL = 3;  // Shader location: vertex attribute: normal
pub const SHADER_LOC_VERTEX_TANGENT = 4;  // Shader location: vertex attribute: tangent
pub const SHADER_LOC_VERTEX_COLOR = 5;  // Shader location: vertex attribute: color
pub const SHADER_LOC_MATRIX_MVP = 6;  // Shader location: matrix uniform: model-view-projection
pub const SHADER_LOC_MATRIX_VIEW = 7;  // Shader location: matrix uniform: view (camera transform)
pub const SHADER_LOC_MATRIX_PROJECTION = 8;  // Shader location: matrix uniform: projection
pub const SHADER_LOC_MATRIX_MODEL = 9;  // Shader location: matrix uniform: model (transform)
pub const SHADER_LOC_MATRIX_NORMAL = 10;  // Shader location: matrix uniform: normal
pub const SHADER_LOC_VECTOR_VIEW = 11;  // Shader location: vector uniform: view
pub const SHADER_LOC_COLOR_DIFFUSE = 12;  // Shader location: vector uniform: diffuse color
pub const SHADER_LOC_COLOR_SPECULAR = 13;  // Shader location: vector uniform: specular color
pub const SHADER_LOC_COLOR_AMBIENT = 14;  // Shader location: vector uniform: ambient color
pub const SHADER_LOC_MAP_ALBEDO = 15;  // Shader location: sampler2d texture: albedo (same as: SHADER_LOC_MAP_DIFFUSE)
pub const SHADER_LOC_MAP_METALNESS = 16;  // Shader location: sampler2d texture: metalness (same as: SHADER_LOC_MAP_SPECULAR)
pub const SHADER_LOC_MAP_NORMAL = 17;  // Shader location: sampler2d texture: normal
pub const SHADER_LOC_MAP_ROUGHNESS = 18;  // Shader location: sampler2d texture: roughness
pub const SHADER_LOC_MAP_OCCLUSION = 19;  // Shader location: sampler2d texture: occlusion
pub const SHADER_LOC_MAP_EMISSION = 20;  // Shader location: sampler2d texture: emission
pub const SHADER_LOC_MAP_HEIGHT = 21;  // Shader location: sampler2d texture: height
pub const SHADER_LOC_MAP_CUBEMAP = 22;  // Shader location: samplerCube texture: cubemap
pub const SHADER_LOC_MAP_IRRADIANCE = 23;  // Shader location: samplerCube texture: irradiance
pub const SHADER_LOC_MAP_PREFILTER = 24;  // Shader location: samplerCube texture: prefilter
pub const SHADER_LOC_MAP_BRDF = 25;  // Shader location: sampler2d texture: brdf
pub const SHADER_LOC_VERTEX_BONEIDS = 26;  // Shader location: vertex attribute: boneIds
pub const SHADER_LOC_VERTEX_BONEWEIGHTS = 27;  // Shader location: vertex attribute: boneWeights
pub const SHADER_LOC_BONE_MATRICES = 28;  // Shader location: array of matrices uniform: boneMatrices

// ShaderUniformDataType: Shader uniform data type
pub const SHADER_UNIFORM_FLOAT = 0;  // Shader uniform type: float
pub const SHADER_UNIFORM_VEC2 = 1;  // Shader uniform type: vec2 (2 float)
pub const SHADER_UNIFORM_VEC3 = 2;  // Shader uniform type: vec3 (3 float)
pub const SHADER_UNIFORM_VEC4 = 3;  // Shader uniform type: vec4 (4 float)
pub const SHADER_UNIFORM_INT = 4;  // Shader uniform type: int
pub const SHADER_UNIFORM_IVEC2 = 5;  // Shader uniform type: ivec2 (2 int)
pub const SHADER_UNIFORM_IVEC3 = 6;  // Shader uniform type: ivec3 (3 int)
pub const SHADER_UNIFORM_IVEC4 = 7;  // Shader uniform type: ivec4 (4 int)
pub const SHADER_UNIFORM_SAMPLER2D = 8;  // Shader uniform type: sampler2d

// ShaderAttributeDataType: Shader attribute data types
pub const SHADER_ATTRIB_FLOAT = 0;  // Shader attribute type: float
pub const SHADER_ATTRIB_VEC2 = 1;  // Shader attribute type: vec2 (2 float)
pub const SHADER_ATTRIB_VEC3 = 2;  // Shader attribute type: vec3 (3 float)
pub const SHADER_ATTRIB_VEC4 = 3;  // Shader attribute type: vec4 (4 float)

// PixelFormat: NOTE: Support depends on OpenGL version and platform
pub const PIXELFORMAT_UNCOMPRESSED_GRAYSCALE = 1;  // 8 bit per pixel (no alpha)
pub const PIXELFORMAT_UNCOMPRESSED_GRAY_ALPHA = 2;  // 8*2 bpp (2 channels)
pub const PIXELFORMAT_UNCOMPRESSED_R5G6B5 = 3;  // 16 bpp
pub const PIXELFORMAT_UNCOMPRESSED_R8G8B8 = 4;  // 24 bpp
pub const PIXELFORMAT_UNCOMPRESSED_R5G5B5A1 = 5;  // 16 bpp (1 bit alpha)
pub const PIXELFORMAT_UNCOMPRESSED_R4G4B4A4 = 6;  // 16 bpp (4 bit alpha)
pub const PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 = 7;  // 32 bpp
pub const PIXELFORMAT_UNCOMPRESSED_R32 = 8;  // 32 bpp (1 channel - float)
pub const PIXELFORMAT_UNCOMPRESSED_R32G32B32 = 9;  // 32*3 bpp (3 channels - float)
pub const PIXELFORMAT_UNCOMPRESSED_R32G32B32A32 = 10;  // 32*4 bpp (4 channels - float)
pub const PIXELFORMAT_UNCOMPRESSED_R16 = 11;  // 16 bpp (1 channel - half float)
pub const PIXELFORMAT_UNCOMPRESSED_R16G16B16 = 12;  // 16*3 bpp (3 channels - half float)
pub const PIXELFORMAT_UNCOMPRESSED_R16G16B16A16 = 13;  // 16*4 bpp (4 channels - half float)
pub const PIXELFORMAT_COMPRESSED_DXT1_RGB = 14;  // 4 bpp (no alpha)
pub const PIXELFORMAT_COMPRESSED_DXT1_RGBA = 15;  // 4 bpp (1 bit alpha)
pub const PIXELFORMAT_COMPRESSED_DXT3_RGBA = 16;  // 8 bpp
pub const PIXELFORMAT_COMPRESSED_DXT5_RGBA = 17;  // 8 bpp
pub const PIXELFORMAT_COMPRESSED_ETC1_RGB = 18;  // 4 bpp
pub const PIXELFORMAT_COMPRESSED_ETC2_RGB = 19;  // 4 bpp
pub const PIXELFORMAT_COMPRESSED_ETC2_EAC_RGBA = 20;  // 8 bpp
pub const PIXELFORMAT_COMPRESSED_PVRT_RGB = 21;  // 4 bpp
pub const PIXELFORMAT_COMPRESSED_PVRT_RGBA = 22;  // 4 bpp
pub const PIXELFORMAT_COMPRESSED_ASTC_4x4_RGBA = 23;  // 8 bpp
pub const PIXELFORMAT_COMPRESSED_ASTC_8x8_RGBA = 24;  // 2 bpp

// TextureFilter: NOTE 2: Filter is accordingly set for minification and magnification
pub const TEXTURE_FILTER_POINT = 0;  // No filter, just pixel approximation
pub const TEXTURE_FILTER_BILINEAR = 1;  // Linear filtering
pub const TEXTURE_FILTER_TRILINEAR = 2;  // Trilinear filtering (linear with mipmaps)
pub const TEXTURE_FILTER_ANISOTROPIC_4X = 3;  // Anisotropic filtering 4x
pub const TEXTURE_FILTER_ANISOTROPIC_8X = 4;  // Anisotropic filtering 8x
pub const TEXTURE_FILTER_ANISOTROPIC_16X = 5;  // Anisotropic filtering 16x

// TextureWrap: Texture parameters: wrap mode
pub const TEXTURE_WRAP_REPEAT = 0;  // Repeats texture in tiled mode
pub const TEXTURE_WRAP_CLAMP = 1;  // Clamps texture to edge pixel in tiled mode
pub const TEXTURE_WRAP_MIRROR_REPEAT = 2;  // Mirrors and repeats the texture in tiled mode
pub const TEXTURE_WRAP_MIRROR_CLAMP = 3;  // Mirrors and clamps to border the texture in tiled mode

// CubemapLayout: Cubemap layouts
pub const CUBEMAP_LAYOUT_AUTO_DETECT = 0;  // Automatically detect layout type
pub const CUBEMAP_LAYOUT_LINE_VERTICAL = 1;  // Layout is defined by a vertical line with faces
pub const CUBEMAP_LAYOUT_LINE_HORIZONTAL = 2;  // Layout is defined by a horizontal line with faces
pub const CUBEMAP_LAYOUT_CROSS_THREE_BY_FOUR = 3;  // Layout is defined by a 3x4 cross with cubemap faces
pub const CUBEMAP_LAYOUT_CROSS_FOUR_BY_THREE = 4;  // Layout is defined by a 4x3 cross with cubemap faces

// FontType: Font type, defines generation method
pub const FONT_DEFAULT = 0;  // Default font generation, anti-aliased
pub const FONT_BITMAP = 1;  // Bitmap font generation, no anti-aliasing
pub const FONT_SDF = 2;  // SDF font generation, requires external shader

// BlendMode: Color blending modes (pre-defined)
pub const BLEND_ALPHA = 0;  // Blend textures considering alpha (default)
pub const BLEND_ADDITIVE = 1;  // Blend textures adding colors
pub const BLEND_MULTIPLIED = 2;  // Blend textures multiplying colors
pub const BLEND_ADD_COLORS = 3;  // Blend textures adding colors (alternative)
pub const BLEND_SUBTRACT_COLORS = 4;  // Blend textures subtracting colors (alternative)
pub const BLEND_ALPHA_PREMULTIPLY = 5;  // Blend premultiplied textures considering alpha
pub const BLEND_CUSTOM = 6;  // Blend textures using custom src/dst factors (use rlSetBlendFactors())
pub const BLEND_CUSTOM_SEPARATE = 7;  // Blend textures using custom rgb/alpha separate src/dst factors (use rlSetBlendFactorsSeparate())

// Gesture: NOTE: Provided as bit-wise flags to enable only desired gestures
pub const GESTURE_NONE = 0;  // No gesture
pub const GESTURE_TAP = 1;  // Tap gesture
pub const GESTURE_DOUBLETAP = 2;  // Double tap gesture
pub const GESTURE_HOLD = 4;  // Hold gesture
pub const GESTURE_DRAG = 8;  // Drag gesture
pub const GESTURE_SWIPE_RIGHT = 16;  // Swipe right gesture
pub const GESTURE_SWIPE_LEFT = 32;  // Swipe left gesture
pub const GESTURE_SWIPE_UP = 64;  // Swipe up gesture
pub const GESTURE_SWIPE_DOWN = 128;  // Swipe down gesture
pub const GESTURE_PINCH_IN = 256;  // Pinch in gesture
pub const GESTURE_PINCH_OUT = 512;  // Pinch out gesture

// CameraMode: Camera system modes
pub const CAMERA_CUSTOM = 0;  // Camera custom, controlled by user (UpdateCamera() does nothing)
pub const CAMERA_FREE = 1;  // Camera free mode
pub const CAMERA_ORBITAL = 2;  // Camera orbital, around target, zoom supported
pub const CAMERA_FIRST_PERSON = 3;  // Camera first person
pub const CAMERA_THIRD_PERSON = 4;  // Camera third person

// CameraProjection: Camera projection
pub const CAMERA_PERSPECTIVE = 0;  // Perspective projection
pub const CAMERA_ORTHOGRAPHIC = 1;  // Orthographic projection

// NPatchLayout: N-patch layout
pub const NPATCH_NINE_PATCH = 0;  // Npatch layout: 3x3 tiles
pub const NPATCH_THREE_PATCH_VERTICAL = 1;  // Npatch layout: 1x3 tiles
pub const NPATCH_THREE_PATCH_HORIZONTAL = 2;  // Npatch layout: 3x1 tiles

