// Basic shapes drawing functions

// Draw a pixel using geometry [Can be slow, use with care]
pub extern "raylib" fn DrawPixel(posX: Int32, posY: Int32, color: Color);
// Draw a pixel using geometry (Vector version) [Can be slow, use with care]
pub extern "raylib" fn DrawPixelV(position: Vector2, color: Color);
// Draw a line
pub extern "raylib" fn DrawLine(startPosX: Int32, startPosY: Int32, endPosX: Int32, endPosY: Int32, color: Color);
// Draw a line (using gl lines)
pub extern "raylib" fn DrawLineV(startPos: Vector2, endPos: Vector2, color: Color);
// Draw a line (using triangles/quads)
pub extern "raylib" fn DrawLineEx(startPos: Vector2, endPos: Vector2, thick: Float32, color: Color);
// Draw lines sequence (using gl lines)
pub extern "raylib" fn DrawLineStrip(points: Pointer, pointCount: Int32, color: Color);
// Draw line segment cubic-bezier in-out interpolation
pub extern "raylib" fn DrawLineBezier(startPos: Vector2, endPos: Vector2, thick: Float32, color: Color);
// Draw a color-filled circle
pub extern "raylib" fn DrawCircle(centerX: Int32, centerY: Int32, radius: Float32, color: Color);
// Draw a piece of a circle
pub extern "raylib" fn DrawCircleSector(center: Vector2, radius: Float32, startAngle: Float32, endAngle: Float32, segments: Int32, color: Color);
// Draw circle sector outline
pub extern "raylib" fn DrawCircleSectorLines(center: Vector2, radius: Float32, startAngle: Float32, endAngle: Float32, segments: Int32, color: Color);
// Draw a gradient-filled circle
pub extern "raylib" fn DrawCircleGradient(centerX: Int32, centerY: Int32, radius: Float32, inner: Color, outer: Color);
// Draw a color-filled circle (Vector version)
pub extern "raylib" fn DrawCircleV(center: Vector2, radius: Float32, color: Color);
// Draw circle outline
pub extern "raylib" fn DrawCircleLines(centerX: Int32, centerY: Int32, radius: Float32, color: Color);
// Draw circle outline (Vector version)
pub extern "raylib" fn DrawCircleLinesV(center: Vector2, radius: Float32, color: Color);
// Draw ellipse
pub extern "raylib" fn DrawEllipse(centerX: Int32, centerY: Int32, radiusH: Float32, radiusV: Float32, color: Color);
// Draw ellipse outline
pub extern "raylib" fn DrawEllipseLines(centerX: Int32, centerY: Int32, radiusH: Float32, radiusV: Float32, color: Color);
// Draw ring
pub extern "raylib" fn DrawRing(center: Vector2, innerRadius: Float32, outerRadius: Float32, startAngle: Float32, endAngle: Float32, segments: Int32, color: Color);
// Draw ring outline
pub extern "raylib" fn DrawRingLines(center: Vector2, innerRadius: Float32, outerRadius: Float32, startAngle: Float32, endAngle: Float32, segments: Int32, color: Color);
// Draw a color-filled rectangle
pub extern "raylib" fn DrawRectangle(posX: Int32, posY: Int32, width: Int32, height: Int32, color: Color);
// Draw a color-filled rectangle (Vector version)
pub extern "raylib" fn DrawRectangleV(position: Vector2, size: Vector2, color: Color);
// Draw a color-filled rectangle
pub extern "raylib" fn DrawRectangleRec(rec: Rectangle, color: Color);
// Draw a color-filled rectangle with pro parameters
pub extern "raylib" fn DrawRectanglePro(rec: Rectangle, origin: Vector2, rotation: Float32, color: Color);
// Draw a vertical-gradient-filled rectangle
pub extern "raylib" fn DrawRectangleGradientV(posX: Int32, posY: Int32, width: Int32, height: Int32, top: Color, bottom: Color);
// Draw a horizontal-gradient-filled rectangle
pub extern "raylib" fn DrawRectangleGradientH(posX: Int32, posY: Int32, width: Int32, height: Int32, left: Color, right: Color);
// Draw a gradient-filled rectangle with custom vertex colors
pub extern "raylib" fn DrawRectangleGradientEx(rec: Rectangle, topLeft: Color, bottomLeft: Color, topRight: Color, bottomRight: Color);
// Draw rectangle outline
pub extern "raylib" fn DrawRectangleLines(posX: Int32, posY: Int32, width: Int32, height: Int32, color: Color);
// Draw rectangle outline with extended parameters
pub extern "raylib" fn DrawRectangleLinesEx(rec: Rectangle, lineThick: Float32, color: Color);
// Draw rectangle with rounded edges
pub extern "raylib" fn DrawRectangleRounded(rec: Rectangle, roundness: Float32, segments: Int32, color: Color);
// Draw rectangle lines with rounded edges
pub extern "raylib" fn DrawRectangleRoundedLines(rec: Rectangle, roundness: Float32, segments: Int32, color: Color);
// Draw rectangle with rounded edges outline
pub extern "raylib" fn DrawRectangleRoundedLinesEx(rec: Rectangle, roundness: Float32, segments: Int32, lineThick: Float32, color: Color);
// Draw a color-filled triangle (vertex in counter-clockwise order!)
pub extern "raylib" fn DrawTriangle(v1: Vector2, v2: Vector2, v3: Vector2, color: Color);
// Draw triangle outline (vertex in counter-clockwise order!)
pub extern "raylib" fn DrawTriangleLines(v1: Vector2, v2: Vector2, v3: Vector2, color: Color);
// Draw a triangle fan defined by points (first vertex is the center)
pub extern "raylib" fn DrawTriangleFan(points: Pointer, pointCount: Int32, color: Color);
// Draw a triangle strip defined by points
pub extern "raylib" fn DrawTriangleStrip(points: Pointer, pointCount: Int32, color: Color);
// Draw a regular polygon (Vector version)
pub extern "raylib" fn DrawPoly(center: Vector2, sides: Int32, radius: Float32, rotation: Float32, color: Color);
// Draw a polygon outline of n sides
pub extern "raylib" fn DrawPolyLines(center: Vector2, sides: Int32, radius: Float32, rotation: Float32, color: Color);
// Draw a polygon outline of n sides with extended parameters
pub extern "raylib" fn DrawPolyLinesEx(center: Vector2, sides: Int32, radius: Float32, rotation: Float32, lineThick: Float32, color: Color);

// Splines drawing functions

// Draw spline: Linear, minimum 2 points
pub extern "raylib" fn DrawSplineLinear(points: Pointer, pointCount: Int32, thick: Float32, color: Color);
// Draw spline: B-Spline, minimum 4 points
pub extern "raylib" fn DrawSplineBasis(points: Pointer, pointCount: Int32, thick: Float32, color: Color);
// Draw spline: Catmull-Rom, minimum 4 points
pub extern "raylib" fn DrawSplineCatmullRom(points: Pointer, pointCount: Int32, thick: Float32, color: Color);
// Draw spline: Quadratic Bezier, minimum 3 points (1 control point): [p1, c2, p3, c4...]
pub extern "raylib" fn DrawSplineBezierQuadratic(points: Pointer, pointCount: Int32, thick: Float32, color: Color);
// Draw spline: Cubic Bezier, minimum 4 points (2 control points): [p1, c2, c3, p4, c5, c6...]
pub extern "raylib" fn DrawSplineBezierCubic(points: Pointer, pointCount: Int32, thick: Float32, color: Color);
// Draw spline segment: Linear, 2 points
pub extern "raylib" fn DrawSplineSegmentLinear(p1: Vector2, p2: Vector2, thick: Float32, color: Color);
// Draw spline segment: B-Spline, 4 points
pub extern "raylib" fn DrawSplineSegmentBasis(p1: Vector2, p2: Vector2, p3: Vector2, p4: Vector2, thick: Float32, color: Color);
// Draw spline segment: Catmull-Rom, 4 points
pub extern "raylib" fn DrawSplineSegmentCatmullRom(p1: Vector2, p2: Vector2, p3: Vector2, p4: Vector2, thick: Float32, color: Color);
// Draw spline segment: Quadratic Bezier, 2 points, 1 control point
pub extern "raylib" fn DrawSplineSegmentBezierQuadratic(p1: Vector2, c2: Vector2, p3: Vector2, thick: Float32, color: Color);
// Draw spline segment: Cubic Bezier, 2 points, 2 control points
pub extern "raylib" fn DrawSplineSegmentBezierCubic(p1: Vector2, c2: Vector2, c3: Vector2, p4: Vector2, thick: Float32, color: Color);
// Get (evaluate) spline point: Linear
pub extern "raylib" fn GetSplinePointLinear(startPos: Vector2, endPos: Vector2, t: Float32) -> Vector2;
// Get (evaluate) spline point: B-Spline
pub extern "raylib" fn GetSplinePointBasis(p1: Vector2, p2: Vector2, p3: Vector2, p4: Vector2, t: Float32) -> Vector2;
// Get (evaluate) spline point: Catmull-Rom
pub extern "raylib" fn GetSplinePointCatmullRom(p1: Vector2, p2: Vector2, p3: Vector2, p4: Vector2, t: Float32) -> Vector2;
// Get (evaluate) spline point: Quadratic Bezier
pub extern "raylib" fn GetSplinePointBezierQuad(p1: Vector2, c2: Vector2, p3: Vector2, t: Float32) -> Vector2;
// Get (evaluate) spline point: Cubic Bezier
pub extern "raylib" fn GetSplinePointBezierCubic(p1: Vector2, c2: Vector2, c3: Vector2, p4: Vector2, t: Float32) -> Vector2;

// Basic shapes collision detection functions

// Check collision between two rectangles
pub extern "raylib" fn CheckCollisionRecs(rec1: Rectangle, rec2: Rectangle) -> Bool;
// Check collision between two circles
pub extern "raylib" fn CheckCollisionCircles(center1: Vector2, radius1: Float32, center2: Vector2, radius2: Float32) -> Bool;
// Check collision between circle and rectangle
pub extern "raylib" fn CheckCollisionCircleRec(center: Vector2, radius: Float32, rec: Rectangle) -> Bool;
// Check if circle collides with a line created betweeen two points [p1] and [p2]
pub extern "raylib" fn CheckCollisionCircleLine(center: Vector2, radius: Float32, p1: Vector2, p2: Vector2) -> Bool;
// Check if point is inside rectangle
pub extern "raylib" fn CheckCollisionPointRec(point: Vector2, rec: Rectangle) -> Bool;
// Check if point is inside circle
pub extern "raylib" fn CheckCollisionPointCircle(point: Vector2, center: Vector2, radius: Float32) -> Bool;
// Check if point is inside a triangle
pub extern "raylib" fn CheckCollisionPointTriangle(point: Vector2, p1: Vector2, p2: Vector2, p3: Vector2) -> Bool;
// Check if point belongs to line created between two points [p1] and [p2] with defined margin in pixels [threshold]
pub extern "raylib" fn CheckCollisionPointLine(point: Vector2, p1: Vector2, p2: Vector2, threshold: Int32) -> Bool;
// Check if point is within a polygon described by array of vertices
pub extern "raylib" fn CheckCollisionPointPoly(point: Vector2, points: Pointer, pointCount: Int32) -> Bool;
// Check the collision between two lines defined by two points each, returns collision point by reference
pub extern "raylib" fn CheckCollisionLines(startPos1: Vector2, endPos1: Vector2, startPos2: Vector2, endPos2: Vector2, collisionPoint: Pointer) -> Bool;
// Get collision rectangle for two rectangles collision
pub extern "raylib" fn GetCollisionRec(rec1: Rectangle, rec2: Rectangle) -> Rectangle;

// Texture Loading and Drawing Functions (Module: textures)

// Image loading functions

// NOTE: These functions do not require GPU access

// Load image from file into CPU memory (RAM)
