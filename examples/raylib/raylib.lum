// Global Variables Definition

// Window and Graphics Device Functions (Module: core)

// Window-related functions

// Initialize window and OpenGL context
pub extern "raylib" fn InitWindow(width: Int32, height: Int32, title: CString);
// Close window and unload OpenGL context
pub extern "raylib" fn CloseWindow();
// Check if application should close (KEY_ESCAPE pressed or windows close icon clicked)
pub extern "raylib" fn WindowShouldClose() -> Bool;
// Check if window has been initialized successfully
pub extern "raylib" fn IsWindowReady() -> Bool;
// Check if window is currently fullscreen
pub extern "raylib" fn IsWindowFullscreen() -> Bool;
// Check if window is currently hidden
pub extern "raylib" fn IsWindowHidden() -> Bool;
// Check if window is currently minimized
pub extern "raylib" fn IsWindowMinimized() -> Bool;
// Check if window is currently maximized
pub extern "raylib" fn IsWindowMaximized() -> Bool;
// Check if window is currently focused
pub extern "raylib" fn IsWindowFocused() -> Bool;
// Check if window has been resized last frame
pub extern "raylib" fn IsWindowResized() -> Bool;
// Check if one specific window flag is enabled
pub extern "raylib" fn IsWindowState(flag: UInt32) -> Bool;
// Set window configuration state using flags
pub extern "raylib" fn SetWindowState(flags: UInt32);
// Clear window configuration state flags
pub extern "raylib" fn ClearWindowState(flags: UInt32);
// Toggle window state: fullscreen/windowed, resizes monitor to match window resolution
pub extern "raylib" fn ToggleFullscreen();
// Toggle window state: borderless windowed, resizes window to match monitor resolution
pub extern "raylib" fn ToggleBorderlessWindowed();
// Set window state: maximized, if resizable
pub extern "raylib" fn MaximizeWindow();
// Set window state: minimized, if resizable
pub extern "raylib" fn MinimizeWindow();
// Set window state: not minimized/maximized
pub extern "raylib" fn RestoreWindow();
// Set icon for window (single image, RGBA 32bit)
pub extern "raylib" fn SetWindowIcon(image: Image);
// Set icon for window (multiple images, RGBA 32bit)
pub extern "raylib" fn SetWindowIcons(images: Pointer, count: Int32);
// Set title for window
pub extern "raylib" fn SetWindowTitle(title: CString);
// Set window position on screen
pub extern "raylib" fn SetWindowPosition(x: Int32, y: Int32);
// Set monitor for the current window
pub extern "raylib" fn SetWindowMonitor(monitor: Int32);
// Set window minimum dimensions (for FLAG_WINDOW_RESIZABLE)
pub extern "raylib" fn SetWindowMinSize(width: Int32, height: Int32);
// Set window maximum dimensions (for FLAG_WINDOW_RESIZABLE)
pub extern "raylib" fn SetWindowMaxSize(width: Int32, height: Int32);
// Set window dimensions
pub extern "raylib" fn SetWindowSize(width: Int32, height: Int32);
// Set window opacity [0.0f..1.0f]
pub extern "raylib" fn SetWindowOpacity(opacity: Float32);
// Set window focused
pub extern "raylib" fn SetWindowFocused();
// Get native window handle
pub extern "raylib" fn GetWindowHandle() -> Pointer;
// Get current screen width
pub extern "raylib" fn GetScreenWidth() -> Int32;
// Get current screen height
pub extern "raylib" fn GetScreenHeight() -> Int32;
// Get current render width (it considers HiDPI)
pub extern "raylib" fn GetRenderWidth() -> Int32;
// Get current render height (it considers HiDPI)
pub extern "raylib" fn GetRenderHeight() -> Int32;
// Get number of connected monitors
pub extern "raylib" fn GetMonitorCount() -> Int32;
// Get current monitor where window is placed
pub extern "raylib" fn GetCurrentMonitor() -> Int32;
// Get specified monitor position
pub extern "raylib" fn GetMonitorPosition(monitor: Int32) -> Vector2;
// Get specified monitor width (current video mode used by monitor)
pub extern "raylib" fn GetMonitorWidth(monitor: Int32) -> Int32;
// Get specified monitor height (current video mode used by monitor)
pub extern "raylib" fn GetMonitorHeight(monitor: Int32) -> Int32;
// Get specified monitor physical width in millimetres
pub extern "raylib" fn GetMonitorPhysicalWidth(monitor: Int32) -> Int32;
// Get specified monitor physical height in millimetres
pub extern "raylib" fn GetMonitorPhysicalHeight(monitor: Int32) -> Int32;
// Get specified monitor refresh rate
pub extern "raylib" fn GetMonitorRefreshRate(monitor: Int32) -> Int32;
// Get window position XY on monitor
pub extern "raylib" fn GetWindowPosition() -> Vector2;
// Get window scale DPI factor
pub extern "raylib" fn GetWindowScaleDPI() -> Vector2;
// Get the human-readable, UTF-8 encoded name of the specified monitor
pub extern "raylib" fn GetMonitorName(monitor: Int32) -> CString;
// Set clipboard text content
pub extern "raylib" fn SetClipboardText(text: CString);
// Get clipboard text content
pub extern "raylib" fn GetClipboardText() -> CString;
// Get clipboard image content
pub extern "raylib" fn GetClipboardImage() -> Image;
// Enable waiting for events on EndDrawing(), no automatic event polling
pub extern "raylib" fn EnableEventWaiting();
// Disable waiting for events on EndDrawing(), automatic events polling
pub extern "raylib" fn DisableEventWaiting();

// Cursor-related functions

// Shows cursor
pub extern "raylib" fn ShowCursor();
// Hides cursor
pub extern "raylib" fn HideCursor();
// Check if cursor is not visible
pub extern "raylib" fn IsCursorHidden() -> Bool;
// Enables cursor (unlock cursor)
pub extern "raylib" fn EnableCursor();
// Disables cursor (lock cursor)
pub extern "raylib" fn DisableCursor();
// Check if cursor is on the screen
pub extern "raylib" fn IsCursorOnScreen() -> Bool;

// Drawing-related functions

// Set background color (framebuffer clear color)
pub extern "raylib" fn ClearBackground(color: Color);
// Setup canvas (framebuffer) to start drawing
pub extern "raylib" fn BeginDrawing();
// End canvas drawing and swap buffers (double buffering)
pub extern "raylib" fn EndDrawing();
// Begin 2D mode with custom camera (2D)
pub extern "raylib" fn BeginMode2D(camera: Camera2D);
// Ends 2D mode with custom camera
pub extern "raylib" fn EndMode2D();
// Begin 3D mode with custom camera (3D)
pub extern "raylib" fn BeginMode3D(camera: Camera3D);
// Ends 3D mode and returns to default 2D orthographic mode
pub extern "raylib" fn EndMode3D();
// Begin drawing to render texture
pub extern "raylib" fn BeginTextureMode(target: RenderTexture);
// Ends drawing to render texture
pub extern "raylib" fn EndTextureMode();
// Begin custom shader drawing
pub extern "raylib" fn BeginShaderMode(shader: Shader);
// End custom shader drawing (use default shader)
pub extern "raylib" fn EndShaderMode();
// Begin blending mode (alpha, additive, multiplied, subtract, custom)
pub extern "raylib" fn BeginBlendMode(mode: Int32);
// End blending mode (reset to default: alpha blending)
pub extern "raylib" fn EndBlendMode();
// Begin scissor mode (define screen area for following drawing)
pub extern "raylib" fn BeginScissorMode(x: Int32, y: Int32, width: Int32, height: Int32);
// End scissor mode
pub extern "raylib" fn EndScissorMode();
// Begin stereo rendering (requires VR simulator)
pub extern "raylib" fn BeginVrStereoMode(config: VrStereoConfig);
// End stereo rendering (requires VR simulator)
pub extern "raylib" fn EndVrStereoMode();

// VR stereo config functions for VR simulator

// Load VR stereo config for VR simulator device parameters
pub extern "raylib" fn LoadVrStereoConfig(device: VrDeviceInfo) -> VrStereoConfig;
// Unload VR stereo config
pub extern "raylib" fn UnloadVrStereoConfig(config: VrStereoConfig);

// Shader management functions

// Load shader from files and bind default locations
pub extern "raylib" fn LoadShader(vsFileName: CString, fsFileName: CString) -> Shader;
// Load shader from code strings and bind default locations
pub extern "raylib" fn LoadShaderFromMemory(vsCode: CString, fsCode: CString) -> Shader;
// Check if a shader is valid (loaded on GPU)
pub extern "raylib" fn IsShaderValid(shader: Shader) -> Bool;
// Get shader uniform location
pub extern "raylib" fn GetShaderLocation(shader: Shader, uniformName: CString) -> Int32;
// Get shader attribute location
pub extern "raylib" fn GetShaderLocationAttrib(shader: Shader, attribName: CString) -> Int32;
// Set shader uniform value
pub extern "raylib" fn SetShaderValue(shader: Shader, locIndex: Int32, value: Pointer, uniformType: Int32);
// Set shader uniform value vector
pub extern "raylib" fn SetShaderValueV(shader: Shader, locIndex: Int32, value: Pointer, uniformType: Int32, count: Int32);
// Set shader uniform value (matrix 4x4)
pub extern "raylib" fn SetShaderValueMatrix(shader: Shader, locIndex: Int32, mat: Matrix);
// Set shader uniform value for texture (sampler2d)
pub extern "raylib" fn SetShaderValueTexture(shader: Shader, locIndex: Int32, texture: Texture);
// Unload shader from GPU memory (VRAM)
pub extern "raylib" fn UnloadShader(shader: Shader);

// Screen-space-related functions

// Get a ray trace from screen position (i.e mouse)
pub extern "raylib" fn GetScreenToWorldRay(position: Vector2, camera: Camera3D) -> Ray;
// Get a ray trace from screen position (i.e mouse) in a viewport
pub extern "raylib" fn GetScreenToWorldRayEx(position: Vector2, camera: Camera3D, width: Int32, height: Int32) -> Ray;
// Get the screen space position for a 3d world space position
pub extern "raylib" fn GetWorldToScreen(position: Vector3, camera: Camera3D) -> Vector2;
// Get size position for a 3d world space position
pub extern "raylib" fn GetWorldToScreenEx(position: Vector3, camera: Camera3D, width: Int32, height: Int32) -> Vector2;
// Get the screen space position for a 2d camera world space position
pub extern "raylib" fn GetWorldToScreen2D(position: Vector2, camera: Camera2D) -> Vector2;
// Get the world space position for a 2d camera screen space position
pub extern "raylib" fn GetScreenToWorld2D(position: Vector2, camera: Camera2D) -> Vector2;
// Get camera transform matrix (view matrix)
pub extern "raylib" fn GetCameraMatrix(camera: Camera3D) -> Matrix;
// Get camera 2d transform matrix
pub extern "raylib" fn GetCameraMatrix2D(camera: Camera2D) -> Matrix;

// Timing-related functions

// Set target FPS (maximum)
pub extern "raylib" fn SetTargetFPS(fps: Int32);
// Get time in seconds for last frame drawn (delta time)
pub extern "raylib" fn GetFrameTime() -> Float32;
// Get elapsed time in seconds since InitWindow()
pub extern "raylib" fn GetTime() -> Float64;
// Get current FPS
pub extern "raylib" fn GetFPS() -> Int32;

// Custom frame control functions

// NOTE: Those functions are intended for advanced users that want full control over the frame processing

// Swap back buffer with front buffer (screen drawing)
pub extern "raylib" fn SwapScreenBuffer();
// Register all input events
pub extern "raylib" fn PollInputEvents();
// Wait for some time (halt program execution)
pub extern "raylib" fn WaitTime(seconds: Float64);

// Random values generation functions

// Set the seed for the random number generator
pub extern "raylib" fn SetRandomSeed(seed: UInt32);
// Get a random value between min and max (both included)
pub extern "raylib" fn GetRandomValue(min: Int32, max: Int32) -> Int32;
// Load random values sequence, no values repeated
pub extern "raylib" fn LoadRandomSequence(count: UInt32, min: Int32, max: Int32) -> Pointer;
// Unload random values sequence
pub extern "raylib" fn UnloadRandomSequence(sequence: Pointer);
// Takes a screenshot of current screen (filename extension defines format)
pub extern "raylib" fn TakeScreenshot(fileName: CString);
// Setup init configuration flags (view FLAGS)
pub extern "raylib" fn SetConfigFlags(flags: UInt32);
// Open URL with default system browser (if available)
pub extern "raylib" fn OpenURL(url: CString);
// Set the current threshold (minimum) log level
pub extern "raylib" fn SetTraceLogLevel(logLevel: Int32);
// Internal memory allocator
pub extern "raylib" fn MemAlloc(size: UInt32) -> Pointer;
// Internal memory reallocator
pub extern "raylib" fn MemRealloc(ptr: Pointer, size: UInt32) -> Pointer;
// Internal memory free
pub extern "raylib" fn MemFree(ptr: Pointer);

// Set custom callbacks

// WARNING: Callbacks setup is intended for advanced users

// Files management functions

// Load file data as byte array (read)
pub extern "raylib" fn LoadFileData(fileName: CString, dataSize: Pointer) -> Pointer;
// Unload file data allocated by LoadFileData()
pub extern "raylib" fn UnloadFileData(data: Pointer);
// Save data to file from byte array (write), returns true on success
pub extern "raylib" fn SaveFileData(fileName: CString, data: Pointer, dataSize: Int32) -> Bool;
// Export data to code (.h), returns true on success
pub extern "raylib" fn ExportDataAsCode(data: Pointer, dataSize: Int32, fileName: CString) -> Bool;
// Load text data from file (read), returns a '\0' terminated string
pub extern "raylib" fn LoadFileText(fileName: CString) -> Pointer;
// Unload file text data allocated by LoadFileText()
pub extern "raylib" fn UnloadFileText(text: Pointer);
// Save text data to file (write), string must be '\0' terminated, returns true on success
pub extern "raylib" fn SaveFileText(fileName: CString, text: Pointer) -> Bool;

// File system functions

// Check if file exists
pub extern "raylib" fn FileExists(fileName: CString) -> Bool;
// Check if a directory path exists
pub extern "raylib" fn DirectoryExists(dirPath: CString) -> Bool;
// Check file extension (including point: .png, .wav)
pub extern "raylib" fn IsFileExtension(fileName: CString, ext: CString) -> Bool;
// Get file length in bytes (NOTE: GetFileSize() conflicts with windows.h)
pub extern "raylib" fn GetFileLength(fileName: CString) -> Int32;
// Get pointer to extension for a filename string (includes dot: '.png')
pub extern "raylib" fn GetFileExtension(fileName: CString) -> CString;
// Get pointer to filename for a path string
pub extern "raylib" fn GetFileName(filePath: CString) -> CString;
// Get filename string without extension (uses static string)
pub extern "raylib" fn GetFileNameWithoutExt(filePath: CString) -> CString;
// Get full path for a given fileName with path (uses static string)
pub extern "raylib" fn GetDirectoryPath(filePath: CString) -> CString;
// Get previous directory path for a given path (uses static string)
pub extern "raylib" fn GetPrevDirectoryPath(dirPath: CString) -> CString;
// Get current working directory (uses static string)
pub extern "raylib" fn GetWorkingDirectory() -> CString;
// Get the directory of the running application (uses static string)
pub extern "raylib" fn GetApplicationDirectory() -> CString;
// Create directories (including full path requested), returns 0 on success
pub extern "raylib" fn MakeDirectory(dirPath: CString) -> Int32;
// Change working directory, return true on success
pub extern "raylib" fn ChangeDirectory(dir: CString) -> Bool;
// Check if a given path is a file or a directory
pub extern "raylib" fn IsPathFile(path: CString) -> Bool;
// Check if fileName is valid for the platform/OS
pub extern "raylib" fn IsFileNameValid(fileName: CString) -> Bool;
// Load directory filepaths
pub extern "raylib" fn LoadDirectoryFiles(dirPath: CString) -> FilePathList;
// Load directory filepaths with extension filtering and recursive directory scan. Use 'DIR' in the filter string to include directories in the result
pub extern "raylib" fn LoadDirectoryFilesEx(basePath: CString, filter: CString, scanSubdirs: Bool) -> FilePathList;
// Unload filepaths
pub extern "raylib" fn UnloadDirectoryFiles(files: FilePathList);
// Check if a file has been dropped into window
pub extern "raylib" fn IsFileDropped() -> Bool;
// Load dropped filepaths
pub extern "raylib" fn LoadDroppedFiles() -> FilePathList;
// Unload dropped filepaths
pub extern "raylib" fn UnloadDroppedFiles(files: FilePathList);
// Get file modification time (last write time)
pub extern "raylib" fn GetFileModTime(fileName: CString) -> Int64;

// Compression/Encoding functionality

// Compress data (DEFLATE algorithm), memory must be MemFree()
pub extern "raylib" fn CompressData(data: Pointer, dataSize: Int32, compDataSize: Pointer) -> Pointer;
// Decompress data (DEFLATE algorithm), memory must be MemFree()
pub extern "raylib" fn DecompressData(compData: Pointer, compDataSize: Int32, dataSize: Pointer) -> Pointer;
// Encode data to Base64 string, memory must be MemFree()
pub extern "raylib" fn EncodeDataBase64(data: Pointer, dataSize: Int32, outputSize: Pointer) -> Pointer;
// Decode Base64 string data, memory must be MemFree()
pub extern "raylib" fn DecodeDataBase64(data: Pointer, outputSize: Pointer) -> Pointer;
// Compute CRC32 hash code
pub extern "raylib" fn ComputeCRC32(data: Pointer, dataSize: Int32) -> UInt32;
// Compute MD5 hash code, returns static int[4] (16 bytes)
pub extern "raylib" fn ComputeMD5(data: Pointer, dataSize: Int32) -> Pointer;
// Compute SHA1 hash code, returns static int[5] (20 bytes)
pub extern "raylib" fn ComputeSHA1(data: Pointer, dataSize: Int32) -> Pointer;

// Automation events functionality

// Load automation events list from file, NULL for empty list, capacity = MAX_AUTOMATION_EVENTS
pub extern "raylib" fn LoadAutomationEventList(fileName: CString) -> AutomationEventList;
// Unload automation events list from file
pub extern "raylib" fn UnloadAutomationEventList(list: AutomationEventList);
// Export automation events list as text file
pub extern "raylib" fn ExportAutomationEventList(list: AutomationEventList, fileName: CString) -> Bool;
// Set automation event list to record to
pub extern "raylib" fn SetAutomationEventList(list: Pointer);
// Set automation event internal base frame to start recording
pub extern "raylib" fn SetAutomationEventBaseFrame(frame: Int32);
// Start recording automation events (AutomationEventList must be set)
pub extern "raylib" fn StartAutomationEventRecording();
// Stop recording automation events
pub extern "raylib" fn StopAutomationEventRecording();
// Play a recorded automation event
pub extern "raylib" fn PlayAutomationEvent(event: AutomationEvent);

// Input Handling Functions (Module: core)

// Input-related functions: keyboard

// Check if a key has been pressed once
pub extern "raylib" fn IsKeyPressed(key: Int32) -> Bool;
// Check if a key has been pressed again
pub extern "raylib" fn IsKeyPressedRepeat(key: Int32) -> Bool;
// Check if a key is being pressed
pub extern "raylib" fn IsKeyDown(key: Int32) -> Bool;
// Check if a key has been released once
pub extern "raylib" fn IsKeyReleased(key: Int32) -> Bool;
// Check if a key is NOT being pressed
pub extern "raylib" fn IsKeyUp(key: Int32) -> Bool;
// Get key pressed (keycode), call it multiple times for keys queued, returns 0 when the queue is empty
pub extern "raylib" fn GetKeyPressed() -> Int32;
// Get char pressed (unicode), call it multiple times for chars queued, returns 0 when the queue is empty
pub extern "raylib" fn GetCharPressed() -> Int32;
// Set a custom key to exit program (default is ESC)
pub extern "raylib" fn SetExitKey(key: Int32);

// Input-related functions: gamepads

// Check if a gamepad is available
pub extern "raylib" fn IsGamepadAvailable(gamepad: Int32) -> Bool;
// Get gamepad internal name id
pub extern "raylib" fn GetGamepadName(gamepad: Int32) -> CString;
// Check if a gamepad button has been pressed once
pub extern "raylib" fn IsGamepadButtonPressed(gamepad: Int32, button: Int32) -> Bool;
// Check if a gamepad button is being pressed
pub extern "raylib" fn IsGamepadButtonDown(gamepad: Int32, button: Int32) -> Bool;
// Check if a gamepad button has been released once
pub extern "raylib" fn IsGamepadButtonReleased(gamepad: Int32, button: Int32) -> Bool;
// Check if a gamepad button is NOT being pressed
pub extern "raylib" fn IsGamepadButtonUp(gamepad: Int32, button: Int32) -> Bool;
// Get the last gamepad button pressed
pub extern "raylib" fn GetGamepadButtonPressed() -> Int32;
// Get gamepad axis count for a gamepad
pub extern "raylib" fn GetGamepadAxisCount(gamepad: Int32) -> Int32;
// Get axis movement value for a gamepad axis
pub extern "raylib" fn GetGamepadAxisMovement(gamepad: Int32, axis: Int32) -> Float32;
// Set internal gamepad mappings (SDL_GameControllerDB)
pub extern "raylib" fn SetGamepadMappings(mappings: CString) -> Int32;
// Set gamepad vibration for both motors (duration in seconds)
pub extern "raylib" fn SetGamepadVibration(gamepad: Int32, leftMotor: Float32, rightMotor: Float32, duration: Float32);

// Input-related functions: mouse

// Check if a mouse button has been pressed once
pub extern "raylib" fn IsMouseButtonPressed(button: Int32) -> Bool;
// Check if a mouse button is being pressed
pub extern "raylib" fn IsMouseButtonDown(button: Int32) -> Bool;
// Check if a mouse button has been released once
pub extern "raylib" fn IsMouseButtonReleased(button: Int32) -> Bool;
// Check if a mouse button is NOT being pressed
pub extern "raylib" fn IsMouseButtonUp(button: Int32) -> Bool;
// Get mouse position X
