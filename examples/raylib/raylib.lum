// Load image sequence from memory buffer
pub extern "raylib" fn LoadImageAnimFromMemory(fileType: CString, fileData: Pointer, dataSize: Int32, frames: Pointer) -> Image;
// Load image from memory buffer, fileType refers to extension: i.e. '.png'
pub extern "raylib" fn LoadImageFromMemory(fileType: CString, fileData: Pointer, dataSize: Int32) -> Image;
// Load image from GPU texture data
pub extern "raylib" fn LoadImageFromTexture(texture: Texture) -> Image;
// Load image from screen buffer and (screenshot)
pub extern "raylib" fn LoadImageFromScreen() -> Image;
// Check if an image is valid (data and parameters)
pub extern "raylib" fn IsImageValid(image: Image) -> Bool;
// Unload image from CPU memory (RAM)
pub extern "raylib" fn UnloadImage(image: Image);
// Export image data to file, returns true on success
pub extern "raylib" fn ExportImage(image: Image, fileName: CString) -> Bool;
// Export image to memory buffer
pub extern "raylib" fn ExportImageToMemory(image: Image, fileType: CString, fileSize: Pointer) -> Pointer;
// Export image as code file defining an array of bytes, returns true on success
pub extern "raylib" fn ExportImageAsCode(image: Image, fileName: CString) -> Bool;

// Image generation functions

// Generate image: plain color
pub extern "raylib" fn GenImageColor(width: Int32, height: Int32, color: Color) -> Image;
// Generate image: linear gradient, direction in degrees [0..360], 0=Vertical gradient
pub extern "raylib" fn GenImageGradientLinear(width: Int32, height: Int32, direction: Int32, start: Color, end: Color) -> Image;
// Generate image: radial gradient
