; Extern function call example
; Uses built-in println function

.constants 2
  0: 42i
  1: 100i

.func main 2 0
  NEWEXFUNC r0 println  ; r0 = println function object
  LOADK r1 0            ; r1 = 42
  CALL r0 1             ; println(42) - arg in r1

  NEWEXFUNC r0 println  ; r0 = println function object
  LOADK r1 1            ; r1 = 100
  CALL r0 1             ; println(100) - arg in r1

  LOADNULL r0
  RET r0
.endfunc
