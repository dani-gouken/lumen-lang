// What a cell of a table holds, and how two of them compare and combine.
//
// The rules are those of SQLite, which the tests compare this program
// with: an operation on NULL gives NULL, two whole numbers divide to a
// whole number, a number sorts before any text, and NULL before both.

import std.math;
import std.strings;

pub enum Value {
    Null,
    Int(Int),
    Real(Float),
    Text(String),
}

// A value as a result shows it. A real number always has a decimal point,
// which tells it from a whole one.
pub fn show(value: Value) -> String {
    return match value {
        case Value.Null: "NULL";
        case Value.Int(n): toString(n);
        case Value.Real(x): showReal(x);
        case Value.Text(text): text;
    };
}

fn showReal(x: Float) -> String {
    let text = toString(x);

    if text.contains(".") || text.contains("e") || text.contains("n") {
        return text;
    }

    return text + ".0";
}

// What tells two values apart when rows are grouped, or looked up to be
// joined. A real number that is whole is the whole number.
pub fn key(value: Value) -> String {
    return match value {
        case Value.Null: "n";
        case Value.Int(n): "i" + toString(n);
        case Value.Real(x): realKey(x);
        case Value.Text(text): "t" + text;
    };
}

fn realKey(x: Float) -> String {
    if x > -1000000000000.0 && x < 1000000000000.0 {
        let whole = x.trunc();

        if whole.toFloat() == x {
            return "i" + toString(whole);
        }
    }

    return "r" + toString(x);
}

// Whether a condition holds: null when it cannot be told, which is what
// a comparison with NULL gives. A row is kept only when it does hold.
pub fn truth(value: Value) -> Bool? {
    return match value {
        case Value.Null: null;
        case Value.Int(n): n != 0;
        case Value.Real(x): x != 0.0;
        case Value.Text(text): false;
    };
}

pub fn fromBool(truth: Bool?) -> Value {
    if truth == null {
        return Value.Null;
    }

    if truth {
        return Value.Int(1);
    }

    return Value.Int(0);
}

fn sign(n: Int) -> Int {
    if n < 0 {
        return -1;
    }

    if n > 0 {
        return 1;
    }

    return 0;
}

fn compareReals(a: Float, b: Float) -> Int {
    if a < b {
        return -1;
    }

    if a > b {
        return 1;
    }

    return 0;
}

fn compareTexts(a: String, b: String) -> Int {
    if a < b {
        return -1;
    }

    if a > b {
        return 1;
    }

    return 0;
}

// The order of two values, for sorting: negative when a comes first.
// NULL comes before everything, a number before any text.
pub fn order(a: Value, b: Value) -> Int {
    match (a, b) {
        case (Value.Null, Value.Null): {
            return 0;
        }

        case (Value.Null, _): {
            return -1;
        }

        case (_, Value.Null): {
            return 1;
        }

        case (Value.Int(x), Value.Int(y)): {
            return sign(x - y);
        }

        case (Value.Int(x), Value.Real(y)): {
            return compareReals(x.toFloat(), y);
        }

        case (Value.Real(x), Value.Int(y)): {
            return compareReals(x, y.toFloat());
        }

        case (Value.Real(x), Value.Real(y)): {
            return compareReals(x, y);
        }

        case (Value.Text(x), Value.Text(y)): {
            return compareTexts(x, y);
        }

        case (Value.Text(x), _): {
            return 1;
        }

        case (_, Value.Text(y)): {
            return -1;
        }
    }
}

// The same for a comparison in a condition, where NULL compares with
// nothing: null if either is.
pub fn compare(a: Value, b: Value) -> Int? {
    if a == Value.Null || b == Value.Null {
        return null;
    }

    return order(a, b);
}

// A value as a number, for arithmetic: a text counts as zero.
fn real(value: Value) -> Float {
    return match value {
        case Value.Int(n): n.toFloat();
        case Value.Real(x): x;
        default: 0.0;
    };
}

// Arithmetic. Two whole numbers give a whole number, division included;
// anything real gives a real. Dividing by zero gives NULL.
pub fn arithmetic(operator: String, a: Value, b: Value) -> Value {
    match (a, b) {
        case (Value.Null, _): {
            return Value.Null;
        }

        case (_, Value.Null): {
            return Value.Null;
        }

        case (Value.Int(x), Value.Int(y)): {
            return match operator {
                case "+": Value.Int(x + y);
                case "-": Value.Int(x - y);
                case "*": Value.Int(x * y);

                case "/": {
                    if y == 0 {
                        return Value.Null;
                    }

                    return Value.Int(x / y);
                }

                default: {
                    if y == 0 {
                        return Value.Null;
                    }

                    return Value.Int(x % y);
                }
            };
        }

        default: {}
    }

    let x = real(a);
    let y = real(b);

    return match operator {
        case "+": Value.Real(x + y);
        case "-": Value.Real(x - y);
        case "*": Value.Real(x * y);

        case "/": {
            if y == 0.0 {
                return Value.Null;
            }

            return Value.Real(x / y);
        }

        default: {
            // The remainder is of the whole parts
            let divisor = y.trunc();

            if divisor == 0 {
                return Value.Null;
            }

            return Value.Real((x.trunc() % divisor).toFloat());
        }
    };
}

// A value of a column as it is written in a file.
pub fn parse(text: String, kind: String) -> Value {
    if kind == "int" {
        let n = text.parseInt();

        if n != null {
            return Value.Int(n);
        }

        return Value.Null;
    }

    if kind == "real" {
        let x = text.parseFloat();

        if x != null {
            return Value.Real(x);
        }

        return Value.Null;
    }

    return Value.Text(text);
}
