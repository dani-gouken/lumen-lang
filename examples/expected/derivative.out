f(x)  = 7
f'(x) = 0
        f(2) = 7  f'(2) = 0

f(x)  = 3 * x + 5
f'(x) = 3
        f(2) = 11  f'(2) = 3

f(x)  = x * x + 3 * x
f'(x) = x + x + 3
        f(2) = 10  f'(2) = 7

f(x)  = x^3 - 2 * x
f'(x) = 3 * x^2 - 2
        f(2) = 4  f'(2) = 10

f(x)  = (x + 1)^2
f'(x) = 2 * (x + 1)
        f(2) = 9  f'(2) = 6

