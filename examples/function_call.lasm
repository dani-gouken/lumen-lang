; Function call example
; Defines a simple add function and calls it

.constants 2
  0: 5i
  1: 10i

.func main 4 0
  ; Main code
  NEWFUNC r0 add_func  ; Create function object for add_func
  LOADK r1 0        ; r1 = 5
  LOADK r2 1        ; r2 = 10
  CALL r0 2         ; Call add_func with 2 args (r1, r2)
  ; Result is in r0
  RET r0            ; Return the result
.endfunc

.func add_func 3 2
  ; Function adds r0 + r1
  ; Arguments: r0, r1
  ADD r2 r0 r1      ; r2 = r0 + r1
  RET r2            ; Return r2
.endfunc
