// Functions, recursion, loops and arrays.

import std.arrays;

fn fib(n: Int) -> Int {
    if n < 2 {
        return n;
    }

    return fib(n - 1) + fib(n - 2);
}

// Iterative version: builds the whole sequence in an array.
fn fibSequence(count: Int) -> [Int] {
    let seq: [Int] = [];
    let a = 0;
    let b = 1;

    for i in 0..count {
        push(seq, a);
        let next = a + b;
        a = b;
        b = next;
    }

    return seq;
}

fn main() -> Int {
    println("fib(20) =", fib(20));

    let seq = fibSequence(10);
    println("first", arrays.len(seq), "numbers:", seq);

    let total = 0;

    for n in seq {
        total = total + n;
    }

    println("sum =", total);
    return 0;
}
