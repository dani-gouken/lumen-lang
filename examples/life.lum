// Conway's Game of Life.
//
// A grid of cells, each alive or dead. At every step a cell looks at its
// eight neighbours: a live cell stays alive with two or three live
// neighbours, a dead cell comes alive with exactly three.
//
// Shows: arrays of arrays, nested loops, structs with methods, building
// strings.

struct Grid {
    width: Int;
    height: Int;
    cells: [[Bool]];
}

fn newGrid(width: Int, height: Int) -> Grid {
    let cells: [[Bool]] = [];
    for y in 0..height {
        let row: [Bool] = [];
        for x in 0..width { push(row, false); }
        push(cells, row);
    }
    return Grid { width: width, height: height, cells: cells };
}

impl Grid {
    // Cells outside the grid count as dead.
    fn alive(x: Int, y: Int) -> Bool {
        if x < 0 || y < 0 || x >= self.width || y >= self.height {
            return false;
        }
        return self.cells[y][x];
    }

    fn set(x: Int, y: Int) {
        self.cells[y][x] = true;
    }

    fn neighbours(x: Int, y: Int) -> Int {
        let count = 0;
        for dy in [-1, 0, 1] {
            for dx in [-1, 0, 1] {
                if (dx != 0 || dy != 0) && self.alive(x + dx, y + dy) {
                    count++;
                }
            }
        }
        return count;
    }

    // The next generation is a new grid: every cell must be decided from
    // the old one, before anything changes.
    fn step() -> Grid {
        let next = newGrid(self.width, self.height);
        for y, row in self.cells {
            for x, cell in row {
                let n = self.neighbours(x, y);
                if n == 3 || (cell && n == 2) {
                    next.set(x, y);
                }
            }
        }
        return next;
    }

    fn population() -> Int {
        let count = 0;
        for row in self.cells {
            for cell in row {
                if cell { count++; }
            }
        }
        return count;
    }

    fn show() {
        for row in self.cells {
            let line = "";
            for cell in row {
                if cell { line += "#"; } else { line += "."; }
            }
            println(line);
        }
    }
}

fn main() -> Int {
    // A glider: five cells that move one step diagonally every four
    // generations.
    let grid = newGrid(8, 6);
    grid.set(1, 0);
    grid.set(2, 1);
    grid.set(0, 2);
    grid.set(1, 2);
    grid.set(2, 2);

    let generation = 0;
    while generation <= 8 {
        if generation % 4 == 0 {
            println("generation", generation, "population", grid.population());
            grid.show();
            println();
        }
        grid = grid.step();
        generation++;
    }
    return 0;
}
