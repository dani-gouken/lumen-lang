; Example: Create an object and use its fields
;
; This program demonstrates:
; - Object allocation with NEWOBJ
; - Writing a field with SETFIELD and reading it back with GETFIELD
; - Field names as string constants

.constants 2
0: 25i          ; Age value
1: "age"        ; Field name

.func main 3 0
  ; Create new object
  NEWOBJ r0

  ; obj.age = 25
  LOADK r1 0
  SETFIELD r0 1 r1

  ; Read the field back and return it
  GETFIELD r2 r0 1
  RET r2
.endfunc
