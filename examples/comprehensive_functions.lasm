; Comprehensive function example
; Shows labels, function calls, recursion, and extern functions

.constants 4
  0: 3i             ; Input for factorial
  1: 1i             ; Base case and decrement value
  2: 0i             ; For comparison
  3: 2i             ; For multiply example

.func main 6 0
  ; Main program
  NEWFUNC r0 factorial  ; Create factorial function object
  LOADK r1 0        ; r1 = 3
  CALL r0 1         ; result = factorial(3) = 6
  MOV r1 r0         ; Move result to r1 for println
  NEWEXFUNC r0 println  ; r0 = println function object
  CALL r0 1         ; println(6) - arg in r1

  NEWFUNC r0 multiply   ; Create multiply function object
  LOADK r1 3        ; r1 = 2
  LOADK r2 3        ; r2 = 2
  CALL r0 2         ; result = multiply(2, 2) = 4
  MOV r1 r0         ; Move result to r1 for println
  NEWEXFUNC r0 println  ; r0 = println function object
  CALL r0 1         ; println(4) - arg in r1

  LOADNULL r0
  RET r0            ; Return null
.endfunc

; Factorial function (recursive)
.func factorial 5 1
  ; factorial(n) in r0
  LOADK r1 2        ; r1 = 0
  LE r3 r0 r1       ; r3 = (r0 <= 0)
  JMPIF r3 fact_base

  ; Recursive case
  MOV r4 r0         ; Save n
  LOADK r1 1        ; r1 = 1
  SUB r1 r4 r1      ; r1 = n - 1
  NEWFUNC r0 factorial  ; Create function object for recursive call
  CALL r0 1         ; factorial(n-1)
  MUL r2 r4 r0      ; r2 = n * factorial(n-1)
  RET r2

fact_base:
  LOADK r2 1        ; Return 1
  RET r2
.endfunc

; Multiply function (non-recursive)
.func multiply 3 2
  ; multiply(a, b) in r0, r1
  MUL r2 r0 r1      ; r2 = a * b
  RET r2
.endfunc
