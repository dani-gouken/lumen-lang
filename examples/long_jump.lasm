; Example demonstrating long jump instructions
; This program tests JMP.L and JMPIF.L for large code blocks

.constants 3
  0: 10i
  1: 20i
  2: 100i

.func main 4 0
  ; Load initial value
  LOADK r0 0

  ; Jump forward with long jump to skip NOPs
  JMP.L compute_result

  ; Fill space with NOPs to simulate large code block
  NOP
  NOP
  NOP
  NOP
  NOP
  NOP
  NOP
  NOP
  NOP
  NOP

compute_result:
  ; Test conditional long jump
  LOADBOOL r1 true
  JMPIFNOT.L r1 error_case

  ; Create function object for helper
  NEWFUNC r0 add_values

  ; Load arguments for function call
  LOADK r1 0
  LOADK r2 1

  ; Call helper function
  CALL r0 2

  ; r0 now contains result
  RET r0

error_case:
  ; Should not reach here
  LOADK r0 2
  RET r0
.endfunc

; Helper function (far from the call site)
.func add_values 3 2
  ; r0 = 10, r1 = 20
  ADD r2 r0 r1
  ; Return 30
  RET r2
.endfunc
