pub struct Animal {
    name: String;
    weight: Int;
}

pub fn new(name: String, weight: Int) -> Animal {
    return Animal { name: name, weight: positive(weight) };
}

pub fn heaviest(animals: [Animal]) -> Animal {
    let best = animals[0];

    for animal in animals {
        if animal.weight > best.weight {
            best = animal;
        }
    }

    return best;
}

// Without 'pub': a helper other modules cannot call.
fn positive(n: Int) -> Int {
    if n < 1 {
        return 1;
    }

    return n;
}
