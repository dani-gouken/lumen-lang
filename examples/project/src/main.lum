// The entry file of a project. See ../lumen.json:
//
//   "entry"     this file, so `lumen run examples/project` finds it
//   "root"      src, so `import app.guests;` is src/app/guests.lum
//   "packages"  textkit is the folder ../packages/textkit, so
//               `import textkit.format.pad;` is packages/textkit/format/pad.lum

import app.guests;
import textkit;                      // packages/textkit.lum
import textkit.format.pad.{left};    // packages/textkit/format/pad.lum

fn main() -> Int {
    let list = guests.invited();
    for i, name in list {
        println(left(toString(i + 1), 3), textkit.title(name));
    }
    println(textkit.repeat("-", 12));
    println(guests.count(list), "guests");
    return 0;
}
