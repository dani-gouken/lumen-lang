// Step 2: the tokens, read as statements.
//
// One method per rule of the grammar, each calling the rule that binds
// tighter. A method gives null when what it reads is not what the rule
// asks for; the mistake has been reported by then, and `?` passes the
// null on to `declaration`, which skips to where a next statement may
// start and goes on from there, so that one run reports every mistake.
//
//   program     = declaration* EOF
//   declaration = classDecl | funDecl | varDecl | statement
//   statement   = exprStmt | forStmt | ifStmt | printStmt | returnStmt
//               | whileStmt | block
//   expression  = assignment
//   assignment  = ( call "." )? IDENTIFIER "=" assignment | logic_or
//   logic_or    = logic_and ( "or" logic_and )*
//   logic_and   = equality ( "and" equality )*
//   equality    = comparison ( ( "!=" | "==" ) comparison )*
//   comparison  = term ( ( ">" | ">=" | "<" | "<=" ) term )*
//   term        = factor ( ( "-" | "+" ) factor )*
//   factor      = unary ( ( "/" | "*" ) unary )*
//   unary       = ( "!" | "-" ) unary | call
//   call        = primary ( "(" arguments? ")" | "." IDENTIFIER )*
//   primary     = "true" | "false" | "nil" | "this" | NUMBER | STRING
//               | IDENTIFIER | "(" expression ")" | "super" "." IDENTIFIER

import lox.token.{Kind, Token, Reporter};
import lox.tree.{Expr, Stmt, Function, Literal};

// What a program reads as, and how many expressions in it name a variable.
pub struct Program {
    statements: [Stmt];
    names: Int;
}

pub fn parse(tokens: [Token], reporter: Reporter) -> Program {
    let parser = Parser { tokens: tokens, reporter: reporter };
    let statements: [Stmt] = [];

    while !parser.atEnd() {
        let statement = parser.declaration();

        if statement != null {
            statements.push(statement);
        }
    }

    return Program { statements: statements, names: parser.names };
}

const MAX_ARGUMENTS = 255;

struct Parser {
    tokens: [Token];
    reporter: Reporter;
    current: Int = 0;
    names: Int = 0;  // The numbers given out so far
}

impl Parser {
    // --- The tokens ---

    fn peek() -> Token {
        return self.tokens[self.current];
    }

    fn previous() -> Token {
        return self.tokens[self.current - 1];
    }

    fn atEnd() -> Bool {
        return self.peek().kind == Kind.Eof;
    }

    fn check(kind: Kind) -> Bool {
        return self.peek().kind == kind;
    }

    fn advance() -> Token {
        if !self.atEnd() {
            self.current++;
        }

        return self.previous();
    }

    // Takes the next token if it is of a kind
    fn took(kind: Kind) -> Bool {
        if !self.check(kind) {
            return false;
        }

        self.advance();
        return true;
    }

    fn tookAny(kinds: [Kind]) -> Bool {
        for kind in kinds {
            if self.took(kind) {
                return true;
            }
        }

        return false;
    }

    // The next token, which has to be of a kind
    fn expect(kind: Kind, message: String) -> Token? {
        if self.check(kind) {
            return self.advance();
        }

        self.reporter.atToken(self.peek(), message);
        return null;
    }

    fn name() -> Int {
        self.names++;
        return self.names - 1;
    }

    // After a mistake: on to where a statement may start
    fn synchronize() {
        self.advance();

        while !self.atEnd() {
            if self.previous().kind == Kind.Semicolon {
                return;
            }

            match self.peek().kind {
                case Kind.Class
                    | Kind.Fun
                    | Kind.Var
                    | Kind.For
                    | Kind.If
                    | Kind.While
                    | Kind.Print
                    | Kind.Return: {
                    return;
                }

                default: {}
            }

            self.advance();
        }
    }

    // --- Declarations ---

    fn declaration() -> Stmt? {
        let statement = self.declared();

        if statement == null {
            self.synchronize();
        }

        return statement;
    }

    fn declared() -> Stmt? {
        if self.took(Kind.Class) {
            return self.classDeclaration();
        }

        if self.took(Kind.Fun) {
            return Stmt.Function(self.function("function")?);
        }

        if self.took(Kind.Var) {
            return self.varDeclaration();
        }

        return self.statement();
    }

    fn classDeclaration() -> Stmt? {
        let name = self.expect(Kind.Identifier, "Expect class name.")?;

        let superclass: Expr? = null;

        if self.took(Kind.Less) {
            self.expect(Kind.Identifier, "Expect superclass name.")?;
            superclass = Expr.Variable(self.previous(), self.name());
        }

        self.expect(Kind.LeftBrace, "Expect '{' before class body.")?;
        let methods: [Function] = [];

        while !self.check(Kind.RightBrace) && !self.atEnd() {
            methods.push(self.function("method")?);
        }

        self.expect(Kind.RightBrace, "Expect '}' after class body.")?;
        return Stmt.Class(name, superclass, methods);
    }

    fn function(kind: String) -> Function? {
        let name = self.expect(Kind.Identifier, "Expect ${kind} name.")?;
        self.expect(Kind.LeftParen, "Expect '(' after ${kind} name.")?;

        let params: [Token] = [];

        if !self.check(Kind.RightParen) {
            let more = true;

            while more {
                if params.len() >= MAX_ARGUMENTS {
                    self.reporter.atToken(
                        self.peek(),
                        "Can't have more than ${MAX_ARGUMENTS} parameters.",
                    );
                }

                params.push(self.expect(Kind.Identifier, "Expect parameter name.")?);
                more = self.took(Kind.Comma);
            }
        }

        self.expect(Kind.RightParen, "Expect ')' after parameters.")?;

        self.expect(Kind.LeftBrace, "Expect '{' before ${kind} body.")?;
        return Function { name: name, params: params, body: self.block()? };
    }

    fn varDeclaration() -> Stmt? {
        let name = self.expect(Kind.Identifier, "Expect variable name.")?;
        let initializer: Expr? = null;

        if self.took(Kind.Equal) {
            initializer = self.expression()?;
        }

        self.expect(Kind.Semicolon, "Expect ';' after variable declaration.")?;
        return Stmt.Var(name, initializer);
    }

    // --- Statements ---

    fn statement() -> Stmt? {
        if self.took(Kind.For) {
            return self.forStatement();
        }

        if self.took(Kind.If) {
            return self.ifStatement();
        }

        if self.took(Kind.Print) {
            return self.printStatement();
        }

        if self.took(Kind.Return) {
            return self.returnStatement();
        }

        if self.took(Kind.While) {
            return self.whileStatement();
        }

        if self.took(Kind.LeftBrace) {
            return Stmt.Block(self.block()?);
        }

        return self.expressionStatement();
    }

    // A for loop is a while loop written shorter: it is read as one
    fn forStatement() -> Stmt? {
        self.expect(Kind.LeftParen, "Expect '(' after 'for'.")?;

        let initializer: Stmt? = null;

        if self.took(Kind.Semicolon) {
            // None
        } else if self.took(Kind.Var) {
            initializer = self.varDeclaration()?;
        } else {
            initializer = self.expressionStatement()?;
        }

        let condition = Expr.Literal(Literal.Bool(true));

        if !self.check(Kind.Semicolon) {
            condition = self.expression()?;
        }

        self.expect(Kind.Semicolon, "Expect ';' after loop condition.")?;

        let increment: Expr? = null;

        if !self.check(Kind.RightParen) {
            increment = self.expression()?;
        }

        self.expect(Kind.RightParen, "Expect ')' after for clauses.")?;

        let body = self.statement()?;

        if increment != null {
            body = Stmt.Block([body, Stmt.Expression(increment)]);
        }

        body = Stmt.While(condition, body);

        if initializer != null {
            body = Stmt.Block([initializer, body]);
        }

        return body;
    }

    fn ifStatement() -> Stmt? {
        self.expect(Kind.LeftParen, "Expect '(' after 'if'.")?;
        let condition = self.expression()?;
        self.expect(Kind.RightParen, "Expect ')' after if condition.")?;

        let thenBranch = self.statement()?;
        let elseBranch: Stmt? = null;

        if self.took(Kind.Else) {
            elseBranch = self.statement()?;
        }

        return Stmt.If(condition, thenBranch, elseBranch);
    }

    fn printStatement() -> Stmt? {
        let value = self.expression()?;
        self.expect(Kind.Semicolon, "Expect ';' after value.")?;
        return Stmt.Print(value);
    }

    fn returnStatement() -> Stmt? {
        let keyword = self.previous();
        let value: Expr? = null;

        if !self.check(Kind.Semicolon) {
            value = self.expression()?;
        }

        self.expect(Kind.Semicolon, "Expect ';' after return value.")?;
        return Stmt.Return(keyword, value);
    }

    fn whileStatement() -> Stmt? {
        self.expect(Kind.LeftParen, "Expect '(' after 'while'.")?;
        let condition = self.expression()?;
        self.expect(Kind.RightParen, "Expect ')' after condition.")?;
        return Stmt.While(condition, self.statement()?);
    }

    fn expressionStatement() -> Stmt? {
        let value = self.expression()?;
        self.expect(Kind.Semicolon, "Expect ';' after expression.")?;
        return Stmt.Expression(value);
    }

    fn block() -> [Stmt]? {
        let statements: [Stmt] = [];

        while !self.check(Kind.RightBrace) && !self.atEnd() {
            let statement = self.declaration();

            if statement != null {
                statements.push(statement);
            }
        }

        self.expect(Kind.RightBrace, "Expect '}' after block.")?;
        return statements;
    }

    // --- Expressions ---

    fn expression() -> Expr? {
        return self.assignment();
    }

    fn assignment() -> Expr? {
        let target = self.either()?;

        if !self.took(Kind.Equal) {
            return target;
        }

        let equals = self.previous();
        let value = self.assignment()?;

        match target {
            case Expr.Variable(name, number): {
                return Expr.Assign(name, value, self.name());
            }

            case Expr.Get(object, name): {
                return Expr.Set(object, name, value);
            }

            default: {
                // Reported, and read on: the tokens are in a known place
                self.reporter.atToken(equals, "Invalid assignment target.");
                return target;
            }
        }
    }

    fn either() -> Expr? {
        let left = self.both()?;

        while self.took(Kind.Or) {
            let operator = self.previous();
            left = Expr.Logical(left, operator, self.both()?);
        }

        return left;
    }

    fn both() -> Expr? {
        let left = self.equality()?;

        while self.took(Kind.And) {
            let operator = self.previous();
            left = Expr.Logical(left, operator, self.equality()?);
        }

        return left;
    }

    fn equality() -> Expr? {
        let left = self.comparison()?;

        while self.tookAny([Kind.BangEqual, Kind.EqualEqual]) {
            let operator = self.previous();
            left = Expr.Binary(left, operator, self.comparison()?);
        }

        return left;
    }

    fn comparison() -> Expr? {
        let left = self.term()?;

        while self.tookAny([Kind.Greater, Kind.GreaterEqual, Kind.Less, Kind.LessEqual]) {
            let operator = self.previous();
            left = Expr.Binary(left, operator, self.term()?);
        }

        return left;
    }

    fn term() -> Expr? {
        let left = self.factor()?;

        while self.tookAny([Kind.Minus, Kind.Plus]) {
            let operator = self.previous();
            left = Expr.Binary(left, operator, self.factor()?);
        }

        return left;
    }

    fn factor() -> Expr? {
        let left = self.unary()?;

        while self.tookAny([Kind.Slash, Kind.Star]) {
            let operator = self.previous();
            left = Expr.Binary(left, operator, self.unary()?);
        }

        return left;
    }

    fn unary() -> Expr? {
        if self.tookAny([Kind.Bang, Kind.Minus]) {
            let operator = self.previous();
            return Expr.Unary(operator, self.unary()?);
        }

        return self.call();
    }

    fn call() -> Expr? {
        let callee = self.primary()?;

        while true {
            if self.took(Kind.LeftParen) {
                callee = self.finishCall(callee)?;
            } else if self.took(Kind.Dot) {
                let name = self.expect(Kind.Identifier, "Expect property name after '.'.")?;
                callee = Expr.Get(callee, name);
            } else {
                return callee;
            }
        }
    }

    fn finishCall(callee: Expr) -> Expr? {
        let arguments: [Expr] = [];

        if !self.check(Kind.RightParen) {
            let more = true;

            while more {
                if arguments.len() >= MAX_ARGUMENTS {
                    self.reporter.atToken(
                        self.peek(),
                        "Can't have more than ${MAX_ARGUMENTS} arguments.",
                    );
                }

                arguments.push(self.expression()?);
                more = self.took(Kind.Comma);
            }
        }

        let paren = self.expect(Kind.RightParen, "Expect ')' after arguments.")?;
        return Expr.Call(callee, paren, arguments);
    }

    fn primary() -> Expr? {
        if self.took(Kind.False) {
            return Expr.Literal(Literal.Bool(false));
        }

        if self.took(Kind.True) {
            return Expr.Literal(Literal.Bool(true));
        }

        if self.took(Kind.Nil) {
            return Expr.Literal(Literal.Nil);
        }

        if self.took(Kind.Number) {
            return Expr.Literal(Literal.Number(self.previous().number));
        }

        if self.took(Kind.Text) {
            return Expr.Literal(Literal.Text(self.previous().text));
        }

        if self.took(Kind.Super) {
            let keyword = self.previous();
            self.expect(Kind.Dot, "Expect '.' after 'super'.")?;
            let method = self.expect(Kind.Identifier, "Expect superclass method name.")?;
            return Expr.Super(keyword, method, self.name());
        }

        if self.took(Kind.This) {
            return Expr.This(self.previous(), self.name());
        }

        if self.took(Kind.Identifier) {
            return Expr.Variable(self.previous(), self.name());
        }

        if self.took(Kind.LeftParen) {
            let inner = self.expression()?;
            self.expect(Kind.RightParen, "Expect ')' after expression.")?;
            return Expr.Grouping(inner);
        }

        self.reporter.atToken(self.peek(), "Expect expression.");
        return null;
    }
}
