// Step 4: the statements, run.
//
// Working out an expression gives a value or fails, and a failure ends
// the program: both are a Result, and `?` passes a failure up through
// every expression and statement that was in progress. A `return` leaves
// the statements it is in the same way, as what running a statement
// gives: go on, or return this value.

import lox.token.{Kind, Token};
import lox.tree.{Expr, Stmt, Function, Literal};
import lox.resolver.{GLOBAL};

// --- Values ---

pub enum Value {
    Nil,
    Bool(Bool),
    Number(Float),
    Text(String),
    Function(Closure),
    Native(String),  // A function the interpreter provides, by its name
    Class(Class),
    Instance(Instance),
}

// A function with the variables that were in reach where it was declared.
struct Closure {
    declaration: Function;
    closure: Environment;
    isInitializer: Bool;
}

struct Class {
    name: String;
    superclass: Class?;
    methods: Dict<Closure>;
}

struct Instance {
    class: Class;
    fields: Dict<Value>;
}

// What a program prints for a value.
pub fn show(value: Value) -> String {
    return match value {
        case Value.Nil: "nil";
        case Value.Bool(truth): toString(truth);
        case Value.Number(number): toString(number);
        case Value.Text(text): text;
        case Value.Function(function): "<fn ${function.declaration.name.lexeme}>";
        case Value.Native(name): "<native fn>";
        case Value.Class(class): class.name;
        case Value.Instance(instance): "${instance.class.name} instance";
    };
}

// Nothing and false are false; everything else is true, zero included.
fn truthy(value: Value) -> Bool {
    return match value {
        case Value.Nil: false;
        case Value.Bool(truth): truth;
        default: true;
    };
}

// Two values are equal if they are the same number, text or truth, or the
// very same function, class or instance. A number equals no text.
fn equal(a: Value, b: Value) -> Bool {
    return match (a, b) {
        // Asked of the numbers themselves: a number that is not one (0/0)
        // equals nothing, the very value it is included
        case (Value.Number(x), Value.Number(y)): x == y;
        case (Value.Text(x), Value.Text(y)): x == y;
        case (Value.Bool(x), Value.Bool(y)): x == y;
        case (Value.Nil, Value.Nil): true;
        case (Value.Native(x), Value.Native(y)): x == y;
        case (Value.Function(x), Value.Function(y)): reflect.identical(x, y);
        case (Value.Class(x), Value.Class(y)): reflect.identical(x, y);
        case (Value.Instance(x), Value.Instance(y)): reflect.identical(x, y);
        default: false;
    };
}

// --- Failures ---

// What stops a running program: what went wrong, and the token it went
// wrong at, for its line.
pub struct RuntimeError {
    token: Token;
    message: String;
}

fn failed(token: Token, message: String) -> RuntimeError {
    return RuntimeError { token: token, message: message };
}

// --- Variables ---

// The variables of one scope, and the scope around it.
struct Environment {
    values: Dict<Value>;
    enclosing: Environment?;
}

fn scope(enclosing: Environment?) -> Environment {
    return Environment { values: dict.empty<Value>(), enclosing: enclosing };
}

impl Environment {
    fn define(name: String, value: Value) {
        self.values.set(name, value);
    }

    // The scope a number of scopes out, which the resolver counted
    fn ancestor(distance: Int) -> Environment {
        let environment = self;

        for step in 0..distance {
            let outer = environment.enclosing;

            if outer == null {
                panic("the resolver counted ${distance} scopes, there are ${step}");
            }

            environment = outer;
        }

        return environment;
    }

    fn at(distance: Int, name: String) -> Value {
        return self.ancestor(distance).values.getOr(name, Value.Nil);
    }
}

// What running a statement gives: go on to the next, or leave the
// function with a value.
enum Flow {
    Next,
    Return(Value),
}

// --- The interpreter ---

pub struct Interpreter {
    distances: [Int];          // From the resolver, by the number of the expression
    globals: Environment;
    environment: Environment;  // The scope the statement being run is in
    print: fn(String) -> Void;
    line: Int = 0;             // The line of the call made last
}

pub fn interpreter(print: fn(String) -> Void) -> Interpreter {
    let globals = scope(null);
    globals.define("clock", Value.Native("clock"));
    return Interpreter { distances: [], globals: globals, environment: globals, print: print };
}

impl Interpreter {
    // Runs a program. The distances are those of this program: a new one
    // run by the same interpreter, as a prompt does, brings its own.
    pub fn run(statements: [Stmt], distances: [Int]) -> RuntimeError? {
        self.distances = distances;

        for statement in statements {
            if self.execute(statement) is Err(error) {
                return error;
            }
        }

        return null;
    }

    // --- Statements ---

    fn execute(statement: Stmt) -> Result<Flow, RuntimeError> {
        match statement {
            case Stmt.Block(statements): {
                return self.block(statements, scope(self.environment));
            }

            case Stmt.Class(name, superclass, methods): {
                self.declareClass(name, superclass, methods)?;
            }

            case Stmt.Expression(value): {
                self.evaluate(value)?;
            }

            case Stmt.Function(declaration): {
                let function = Closure {
                    declaration: declaration,
                    closure: self.environment,
                    isInitializer: false,
                };

                self.environment.define(declaration.name.lexeme, Value.Function(function));
            }

            case Stmt.If(condition, thenBranch, elseBranch): {
                if truthy(self.evaluate(condition)?) {
                    return self.execute(thenBranch);
                }

                if elseBranch != null {
                    return self.execute(elseBranch);
                }
            }

            case Stmt.Print(value): {
                let print = self.print;
                print(show(self.evaluate(value)?));
            }

            case Stmt.Return(keyword, value): {
                if value == null {
                    return Ok(Flow.Return(Value.Nil));
                }

                return Ok(Flow.Return(self.evaluate(value)?));
            }

            case Stmt.Var(name, initializer): {
                let value = Value.Nil;

                if initializer != null {
                    value = self.evaluate(initializer)?;
                }

                self.environment.define(name.lexeme, value);
            }

            case Stmt.While(condition, body): {
                while truthy(self.evaluate(condition)?) {
                    if self.execute(body)? is Flow.Return(value) {
                        return Ok(Flow.Return(value));
                    }
                }
            }
        }

        return Ok(Flow.Next);
    }

    // Runs statements in a scope, and comes back to the one it was in
    // whichever way they end
    fn block(statements: [Stmt], environment: Environment) -> Result<Flow, RuntimeError> {
        let previous = self.environment;
        self.environment = environment;

        defer {
            self.environment = previous;
        }

        for statement in statements {
            if self.execute(statement)? is Flow.Return(value) {
                return Ok(Flow.Return(value));
            }
        }

        return Ok(Flow.Next);
    }

    fn declareClass(
        name: Token,
        superclassExpr: Expr?,
        methods: [Function],
    ) -> Result<Flow, RuntimeError> {
        let superclass: Class? = null;

        if superclassExpr != null {
            if self.evaluate(superclassExpr)? is Value.Class(parent) {
                superclass = parent;
            } else if superclassExpr is Expr.Variable(parentName, _) {
                return Err(failed(parentName, "Superclass must be a class."));
            } else {
                return Err(failed(name, "Superclass must be a class."));
            }
        }

        // The name is there before the class is: its methods may name it
        self.environment.define(name.lexeme, Value.Nil);

        // The methods of a subclass close over a scope that holds `super`
        let closure = self.environment;

        if superclass != null {
            closure = scope(closure);
            closure.define("super", Value.Class(superclass));
        }

        let table = dict.empty<Closure>();

        for method in methods {
            table.set(method.name.lexeme, Closure {
                declaration: method,
                closure: closure,
                isInitializer: method.name.lexeme == "init",
            });
        }

        let class = Class { name: name.lexeme, superclass: superclass, methods: table };
        self.environment.values.set(name.lexeme, Value.Class(class));
        return Ok(Flow.Next);
    }

    // --- Expressions ---

    fn evaluate(expression: Expr) -> Result<Value, RuntimeError> {
        match expression {
            case Expr.Literal(literal): {
                return Ok(match literal {
                    case Literal.Nil: Value.Nil;
                    case Literal.Bool(truth): Value.Bool(truth);
                    case Literal.Number(number): Value.Number(number);
                    case Literal.Text(text): Value.Text(text);
                });
            }

            case Expr.Grouping(inner): {
                return self.evaluate(inner);
            }

            case Expr.Variable(name, number): {
                return self.lookUp(name, number);
            }

            case Expr.This(keyword, number): {
                return self.lookUp(keyword, number);
            }

            case Expr.Assign(name, valueExpr, number): {
                let value = self.evaluate(valueExpr)?;
                let distance = self.distances[number];

                if distance != GLOBAL {
                    self.environment.ancestor(distance).values.set(name.lexeme, value);
                } else if self.globals.values.has(name.lexeme) {
                    self.globals.values.set(name.lexeme, value);
                } else {
                    return Err(failed(name, "Undefined variable '${name.lexeme}'."));
                }

                return Ok(value);
            }

            case Expr.Unary(operator, rightExpr): {
                let right = self.evaluate(rightExpr)?;

                if operator.kind == Kind.Bang {
                    return Ok(Value.Bool(!truthy(right)));
                }

                if right is Value.Number(number) {
                    return Ok(Value.Number(-number));
                }

                return Err(failed(operator, "Operand must be a number."));
            }

            case Expr.Logical(leftExpr, operator, rightExpr): {
                let left = self.evaluate(leftExpr)?;

                // The right side is only worked out if the left has not decided
                if operator.kind == Kind.Or {
                    if truthy(left) {
                        return Ok(left);
                    }
                } else if !truthy(left) {
                    return Ok(left);
                }

                return self.evaluate(rightExpr);
            }

            case Expr.Binary(leftExpr, operator, rightExpr): {
                let left = self.evaluate(leftExpr)?;
                let right = self.evaluate(rightExpr)?;
                return binary(left, operator, right);
            }

            case Expr.Call(calleeExpr, paren, argumentExprs): {
                let callee = self.evaluate(calleeExpr)?;
                let arguments: [Value] = [];

                for argument in argumentExprs {
                    arguments.push(self.evaluate(argument)?);
                }

                return self.call(callee, paren, arguments);
            }

            case Expr.Get(objectExpr, name): {
                if self.evaluate(objectExpr)? is Value.Instance(instance) {
                    return property(instance, name);
                }

                return Err(failed(name, "Only instances have properties."));
            }

            case Expr.Set(objectExpr, name, valueExpr): {
                if self.evaluate(objectExpr)? is Value.Instance(instance) {
                    let value = self.evaluate(valueExpr)?;
                    instance.fields.set(name.lexeme, value);
                    return Ok(value);
                }

                return Err(failed(name, "Only instances have fields."));
            }

            case Expr.Super(keyword, methodName, number): {
                // `super` is one scope out of `this`, where the resolver found it
                let distance = self.distances[number];

                match (
                    self.environment.at(distance, "super"),
                    self.environment.at(distance - 1, "this"),
                ) {
                    case (Value.Class(superclass), Value.Instance(object)): {
                        let method = findMethod(superclass, methodName.lexeme);

                        if method == null {
                            return Err(
                                failed(methodName, "Undefined property '${methodName.lexeme}'."),
                            );
                        }

                        return Ok(Value.Function(bind(method, object)));
                    }

                    default: {
                        panic("'super' without a superclass and an instance in reach");
                    }
                }
            }
        }
    }

    fn lookUp(name: Token, number: Int) -> Result<Value, RuntimeError> {
        let distance = self.distances[number];

        if distance != GLOBAL {
            return Ok(self.environment.at(distance, name.lexeme));
        }

        let value = self.globals.values.get(name.lexeme);

        if value == null {
            return Err(failed(name, "Undefined variable '${name.lexeme}'."));
        }

        return Ok(value);
    }

    // --- Calls ---

    fn call(callee: Value, paren: Token, arguments: [Value]) -> Result<Value, RuntimeError> {
        self.line = paren.line;

        match callee {
            case Value.Function(function): {
                checkArity(function.declaration.params.len(), arguments, paren)?;
                return self.invoke(function, arguments);
            }

            case Value.Class(class): {
                let instance = Instance { class: class, fields: dict.empty<Value>() };
                let initializer = findMethod(class, "init");

                if initializer == null {
                    checkArity(0, arguments, paren)?;
                } else {
                    checkArity(initializer.declaration.params.len(), arguments, paren)?;
                    self.invoke(bind(initializer, instance), arguments)?;
                }

                return Ok(Value.Instance(instance));
            }

            case Value.Native(name): {
                checkArity(0, arguments, paren)?;
                // The only one there is: the seconds on the clock
                return Ok(Value.Number(time.ticks().toFloat() / 1000000.0));
            }

            default: {
                return Err(failed(paren, "Can only call functions and classes."));
            }
        }
    }

    fn invoke(function: Closure, arguments: [Value]) -> Result<Value, RuntimeError> {
        let environment = scope(function.closure);

        for i, param in function.declaration.params {
            environment.define(param.lexeme, arguments[i]);
        }

        let flow = self.block(function.declaration.body, environment)?;

        // An initializer gives the instance, whatever it returns
        if function.isInitializer {
            return Ok(function.closure.at(0, "this"));
        }

        return match flow {
            case Flow.Return(value): Ok(value);
            case Flow.Next: Ok(Value.Nil);
        };
    }
}

fn checkArity(expected: Int, arguments: [Value], paren: Token) -> Result<Int, RuntimeError> {
    if arguments.len() != expected {
        return Err(failed(paren, "Expected ${expected} arguments but got ${arguments.len()}."));
    }

    return Ok(expected);
}

fn findMethod(class: Class, name: String) -> Closure? {
    let method = class.methods.get(name);

    if method != null {
        return method;
    }

    return findMethod(class.superclass?, name);
}

// A method taken off an instance remembers the instance: `this` in it.
fn bind(method: Closure, instance: Instance) -> Closure {
    let environment = scope(method.closure);
    environment.define("this", Value.Instance(instance));

    return Closure {
        declaration: method.declaration,
        closure: environment,
        isInitializer: method.isInitializer,
    };
}

fn property(instance: Instance, name: Token) -> Result<Value, RuntimeError> {
    let field = instance.fields.get(name.lexeme);

    if field != null {
        return Ok(field);
    }

    let method = findMethod(instance.class, name.lexeme);

    if method != null {
        return Ok(Value.Function(bind(method, instance)));
    }

    return Err(failed(name, "Undefined property '${name.lexeme}'."));
}

fn binary(left: Value, operator: Token, right: Value) -> Result<Value, RuntimeError> {
    if operator.kind == Kind.EqualEqual {
        return Ok(Value.Bool(equal(left, right)));
    }

    if operator.kind == Kind.BangEqual {
        return Ok(Value.Bool(!equal(left, right)));
    }

    if left is Value.Number(a) && right is Value.Number(b) {
        return Ok(match operator.kind {
            case Kind.Plus: Value.Number(a + b);
            case Kind.Minus: Value.Number(a - b);
            case Kind.Star: Value.Number(a * b);
            case Kind.Slash: Value.Number(a / b);
            case Kind.Greater: Value.Bool(a > b);
            case Kind.GreaterEqual: Value.Bool(a >= b);
            case Kind.Less: Value.Bool(a < b);
            case Kind.LessEqual: Value.Bool(a <= b);

            default: {
                panic("'${operator.lexeme}' is not an operator on two values");
            }
        });
    }

    if left is Value.Text(a) && right is Value.Text(b) && operator.kind == Kind.Plus {
        return Ok(Value.Text(a + b));
    }

    if operator.kind == Kind.Plus {
        return Err(failed(operator, "Operands must be two numbers or two strings."));
    }

    return Err(failed(operator, "Operands must be numbers."));
}
