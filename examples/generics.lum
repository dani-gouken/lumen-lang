// Generic functions, variadic parameters and match.

fn first<T>(items: [T]) -> T {
    return items[0];
}

// A variadic parameter collects the remaining arguments into an array.
fn collect<T>(items: ...T) -> [T] {
    return items;
}

fn join(separator: String, parts: ...String) -> String {
    let out = "";
    let i = 0;

    for part in parts {
        if i > 0 {
            out = out + separator;
        }

        out = out + part;
        i = i + 1;
    }

    return out;
}

fn spell(n: Int) -> String {
    return match n {
        case 0: "zero";
        case 1: "one";
        case 2: "two";
        default: "many";
    };
}

fn main() -> Int {
    // Type arguments are inferred from the arguments...
    println(first([7, 8, 9]), first(["a", "b"]));
    println(collect(1, 2, 3));
    // ...and can always be written out
    println(first<Float>([1.5]));
    println(join(", ", "red", "green", "blue"));

    for n in [0, 1, 2, 3] {
        print(spell(n), "");
    }

    println("");

    // ?? supplies a default for null, && and || stop as soon as they can
    let missing: String? = null;
    println(missing ?? "default");
    return 0;
}
