// Expressions inside strings: "${expression}".

import std.arrays;
import std.strings;

struct Item {
    name: String;
    price: Int;
    count: Int;
}

enum Status { Paid, Due(Int) }

impl Item {
    fn total() -> Int {
        return self.price * self.count;
    }

    fn line() -> String {
        return "${strings.padRight(self.name, 8)} ${self.count} x ${self.price} = ${strings.padLeft("${self.total()}", 5)}";
    }
}

fn describe(status: Status) -> String {
    match status {
        case Status.Paid: {
            return "paid in full";
        }

        case Status.Due(amount): {
            return "${amount} still to pay";
        }
    }
}

const CURRENCY = "EUR";
const HEADER = "Receipt (all prices in ${CURRENCY})";

fn main() -> Int {
    let items = [
        Item { name: "pen", price: 3, count: 4 },
        Item { name: "notebook", price: 12, count: 2 },
        Item { name: "ink", price: 9, count: 1 },
    ];

    println(HEADER);
    println(strings.repeat("-", strings.len(HEADER)));

    for i, item in items {
        println("${i + 1}. ${item.line()}");
    }

    let total = arrays.sum(
        arrays.map(items, fn(item: Item) -> Int {
            return item.total();
        }),
    );

    println("total: ${total} ${CURRENCY} for ${arrays.len(items)} kinds of thing");
    println("average: ${total / arrays.len(items)}, most expensive: ${arrays.largest(arrays.map(items, fn(item: Item) -> Int { return item.price; })) ?? 0}");

    for status in [Status.Paid, Status.Due(total - 20)] {
        println("status: ${status} -> ${describe(status)}");
    }

    // What is not an expression: a dollar alone, braces alone, and an escaped \${
    println("cost: $${total}, a set {a, b}, written as \${total}");
    println("nested: ${"[${strings.upper("${items[0].name}")}]"}, values: ${items[0]}");
    return 0;
}
