// Tasks and channels in one program: a sieve made of tasks in a row, an
// account several tasks draw on, a relay of failures, and work shared
// out between workers.

import std.task;
import std.task.{Task, Channel};
import std.result;
import std.result.{Result, Failure, Kind};
import std.arrays;
import std.strings;
import std.dict;
import std.dict.{Dict};

// --- A sieve: one task per prime, each passing on what it cannot divide ---

fn numbersFrom(start: Int, to: Int) -> Channel<Int> {
    let out = task.channel<Int>(0);
    task.run(fn() {
        for n in arrays.range(start, to) { out.send(n); }
        out.close();
    });
    return out;
}

fn without(multiplesOf: Int, numbers: Channel<Int>) -> Channel<Int> {
    let out = task.channel<Int>(0);
    task.run(fn() {
        numbers.each(fn(n: Int) { if n % multiplesOf != 0 { out.send(n); } });
        out.close();
    });
    return out;
}

fn primesBelow(limit: Int) -> [Int] {
    let primes: [Int] = [];
    let numbers = numbersFrom(2, limit);
    while true {
        let prime = numbers.receive();
        if prime == null { return primes; }
        push(primes, prime);
        numbers = without(prime, numbers);
    }
}

// --- An account: a change in several steps, with a wait in the middle ---

struct Account {
    balance: Int;
    lock: Channel<Bool>;        // holds one value while nobody is changing the account
}

enum Refusal { Short(Int) }

fn openAccount(balance: Int) -> Account {
    let account = Account { balance: balance, lock: task.channel<Bool>(1) };
    account.lock.send(true);
    return account;
}

impl Account {
    // Takes money out if there is enough. Reading the balance and writing
    // it are apart, with a pause between: without the lock two tasks
    // would both read the same balance.
    fn withdraw(amount: Int) -> Result<Int, Refusal> {
        self.lock.receive();
        let before = self.balance;
        task.pause();
        if before < amount {
            self.lock.send(true);
            return Result.Err(Refusal.Short(amount - before));
        }
        self.balance = before - amount;
        self.lock.send(true);
        return Result.Ok(self.balance);
    }

    fn withdrawCarelessly(amount: Int) -> Bool {
        let before = self.balance;
        task.pause();
        if before < amount { return false; }
        self.balance = before - amount;
        return true;
    }
}

// --- Work shared out: each worker takes the next job when it is free ---

struct Job { id: Int; text: String; }
struct Done { job: Int; worker: Int; words: Dict<Int>; }

fn countWords(text: String) -> Dict<Int> {
    let counts = dict.empty<Int>();
    for word in strings.split(strings.lower(text), " ") {
        if word != "" { counts.update(word, 0, n -> n + 1); }
    }
    return counts;
}

fn shareOut(texts: [String], workers: Int) -> [Done] {
    let jobs = task.channel<Job>(arrays.len(texts));
    let done = task.channel<Done>(0);
    for i, text in texts { jobs.send(Job { id: i, text: text }); }
    jobs.close();

    let crew: [Task<Bool>] = [];
    for worker in arrays.range(1, workers + 1) {
        push(crew, task.run(fn() {
            jobs.each(fn(job: Job) {
                done.send(Done { job: job.id, worker: worker, words: countWords(job.text) });
            });
        }));
    }
    task.run(fn() { task.all(crew); done.close(); });
    return arrays.sortedBy(done.drain(), one -> one.job);
}

fn main() -> Int {
    println(primesBelow(60));

    // Ten tasks each try to take 30 out of 100
    let account = openAccount(100);
    let takers = arrays.map(arrays.range(0, 10), n -> task.start(fn() -> Result<Int, Refusal> { return account.withdraw(30); }));
    let taken = 0;
    for taker in takers {
        match taker.wait() {
            case Result.Ok(Result.Ok(left)): { taken++; }
            case Result.Ok(Result.Err(Refusal.Short(by))): { }
            case Result.Err(failure): { println("a withdrawal stopped:", failure.describe()); }
        }
    }
    println(taken, "withdrawals,", account.balance, "left");

    let careless = openAccount(100);
    let lucky = task.map(arrays.range(0, 10), n -> careless.withdrawCarelessly(30));
    println(arrays.count(lucky.orElse([]), went -> went), "careless withdrawals,", careless.balance, "left");

    // Failures cross from task to task as values
    let relay = task.start(fn() -> String {
        let inner = task.start(fn() -> Int { return [1, 2, 3][7]; });
        match inner.wait() {
            case Result.Ok(n): { return "got ${n}"; }
            case Result.Err(failure): { panic("the inner task failed: ${failure.message}"); }
        }
    });
    match relay.wait() {
        case Result.Ok(text): { println(text); }
        case Result.Err(failure): { println(failure.kind == Kind.Panic, failure.message); }
    }

    let texts = ["the cat and the hat", "a cat is a cat", "", "The end"];
    for one in shareOut(texts, 3) {
        let words = arrays.map(one.words.sortedKeys(), word -> "${word}=${one.words.getOr(word, 0)}");
        println("job ${one.job} by worker ${one.worker}:", strings.join(words, " "));
    }

    // main returns; this one is still to run
    task.run(fn() { println("last words from task", task.current() > 0); });
    return 0;
}
