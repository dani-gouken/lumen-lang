// Stock of a small shop, read from text: tuples, `?` to pass a failure
// on, `?.` to read through what may be missing, texts over several lines,
// and tests that reach into function expressions.

import std.result.{Result};
import std.strings;
import std.arrays;
import std.dict;
import std.dict.{Dict};
import std.format;
import std.math;

const stock = """
    # item, quantity, price, supplier
    nails, 500, 0.02, acme
    hammer, 12, 14.50, acme
    saw, 3, 22.00
    glue, , 4.10, bond
    tape, 40, 2.25, bond
    ladder, two, 89.00, heights
    """;

const suppliers = """
    acme = Acme Tools, Leeds
    bond = Bond & Sons
    """;

struct Supplier {
    name: String;
    city: String?;
}

struct Item {
    name: String;
    quantity: Int;
    price: Float;
    supplier: Supplier?;
}

enum Flaw {
    Missing(String),
    NotANumber(String, String),
    UnknownSupplier(String),
}

impl Flaw {
    fn describe() -> String {
        match self {
            case Flaw.Missing(column): {
                return "no ${column}";
            }

            case Flaw.NotANumber(column, text): {
                return "${column} is '${text}', not a number";
            }

            case Flaw.UnknownSupplier(code): {
                return "nobody is known as '${code}'";
            }
        }
    }
}

// "acme = Acme Tools, Leeds" as the code and who it stands for.
fn supplier(line: String) -> (String, Supplier)? {
    let (code, rest) = strings.cut(line, "=")?;
    let (name, city) = strings.cut(rest, ",") ?? (rest, "");
    let where: String? = null;

    if !strings.isBlank(city) {
        where = strings.trim(city);
    }

    return (strings.trim(code), Supplier { name: strings.trim(name), city: where });
}

fn known() -> Dict<Supplier> {
    let all = dict.empty<Supplier>();

    for line in strings.lines(suppliers) {
        let entry = supplier(line);

        if entry != null {
            all.set(entry.0, entry.1);
        }
    }

    return all;
}

// A column of a row, which has to be there and not be empty.
fn column(cells: [String], at: Int, name: String) -> Result<String, Flaw> {
    let text = strings.trim(arrays.at(cells, at) ?? "");

    if text == "" {
        return Result.Err(Flaw.Missing(name));
    }

    return Result.Ok(text);
}

fn whole(cells: [String], at: Int, name: String) -> Result<Int, Flaw> {
    let text = column(cells, at, name)?;
    let n = strings.parseInt(text);

    if n == null {
        return Result.Err(Flaw.NotANumber(name, text));
    }

    return Result.Ok(n);
}

fn item(line: String, suppliers: Dict<Supplier>) -> Result<Item, Flaw> {
    let cells = strings.split(line, ",");
    let name = column(cells, 0, "name")?;
    let quantity = whole(cells, 1, "quantity")?;
    let priceText = column(cells, 2, "price")?;
    let price = strings.parseFloat(priceText);

    if price == null {
        return Result.Err(Flaw.NotANumber("price", priceText));
    }

    // The supplier may be left out; one that is named has to be known
    let from: Supplier? = null;
    let code = strings.trim(arrays.at(cells, 3) ?? "");

    if code != "" {
        from = suppliers.get(code);

        if from == null {
            return Result.Err(Flaw.UnknownSupplier(code));
        }
    }

    return Result.Ok(Item { name: name, quantity: quantity, price: price, supplier: from });
}

// The items that could be read, and the lines that could not with why.
fn load() -> ([Item], [(Int, Flaw)]) {
    let suppliers = known();
    let items: [Item] = [];
    let flawed: [(Int, Flaw)] = [];

    for i, line in strings.lines(stock) {
        if strings.startsWith(line, "#") || strings.isBlank(line) {
            continue;
        }

        match item(line, suppliers) {
            case Result.Ok(read): {
                push(items, read);
            }

            case Result.Err(flaw): {
                push(flawed, (i + 1, flaw));
            }
        }
    }

    return (items, flawed);
}

// The cheapest and the dearest, if there is anything at all.
fn range(items: [Item]) -> (Item, Item)? {
    let cents = fn(item: Item) -> Int {
        return math.round(item.price * 100.0);
    };

    return (arrays.minBy(items, cents)?, arrays.maxBy(items, cents)?);
}

fn worth(item: Item) -> Float {
    return math.toFloat(item.quantity) * item.price;
}

fn level(item: Item) -> String {
    match (item.quantity < 10, item.supplier != null) {
        case (true, true): {
            return "reorder";
        }

        case (true, false): {
            return "find a supplier";
        }

        case (false, _): {
            return "ok";
        }
    }
}

fn main() -> Int {
    let (items, flawed) = load();

    let rows = arrays.map(items, fn(item: Item) -> [String] {
        return [
            item.name,
            toString(item.quantity),
            format.money(worth(item)),
            item.supplier?.name ?? "-",
            item.supplier?.city ?? "-",
            level(item),
        ];
    });

    print(format.table(["item", "qty", "worth", "supplier", "city", "level"], rows));

    let ends = range(items);

    if ends != null {
        let (cheap, dear) = ends;
        println("");
        println("from ${cheap.name} at ${format.money(cheap.price)} to ${dear.name} at ${format.money(dear.price)}");
    }

    println("nothing in stock ranges from", range([]));

    // What a test established holds in the function handed to filter
    let wanted: String? = "acme";

    if wanted != null {
        let theirs = arrays.filter(items, fn(item: Item) -> Bool {
            return strings.len(item.supplier?.name ?? "") == strings.len("Acme Tools")
                && strings.len(wanted) == 4;
        });

        println(
            "from acme:",
            arrays.map(theirs, fn(item: Item) -> String {
                return item.name;
            }),
        );
    }

    println("");

    for (line, flaw) in flawed {
        println("line ${line}: ${flaw.describe()}");
    }

    let (low, fine) = arrays.partition(items, fn(item: Item) -> Bool {
        return item.quantity < 10;
    });

    println("${arrays.len(low)} low, ${arrays.len(fine)} fine, ${arrays.len(flawed)} unread");
    return arrays.len(flawed);
}
