{
  "name": "lumen",
  "displayName": "Lumen",
  "description": "The Lumen language: colours, the language server (mistakes as you type, what a name is, where it is declared, what a file declares, what to write next), formatting and running tests.",
  "version": "0.1.0",
  "publisher": "lumen",
  "license": "MIT",
  "icon": "icons/lum.png",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "lumen",
        "aliases": ["Lumen", "lumen"],
        "extensions": [".lum"],
        "icon": { "light": "./icons/lum-file-light.svg", "dark": "./icons/lum-file-dark.svg" },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lumen",
        "scopeName": "source.lumen",
        "path": "./syntaxes/lumen.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "lumen.restartServer", "title": "Lumen: Restart the language server" },
      { "command": "lumen.runTests", "title": "Lumen: Run the tests" },
      { "command": "lumen.runFileTests", "title": "Lumen: Run the tests of this file" }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "comment.line.double-slash.lumen",
              "keyword.control.lumen",
              "keyword.control.import.lumen",
              "keyword.operator.word.lumen",
              "storage.type.lumen",
              "storage.type.function.lumen",
              "storage.modifier.lumen",
              "variable.language.self.lumen"
            ],
            "settings": { "fontStyle": "italic" }
          }
        ]
      },
      "[lumen]": {
        "editor.defaultFormatter": "lumen.lumen",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "Lumen",
      "properties": {
        "lumen.path": {
          "type": "string",
          "default": "",
          "description": "The lumen program to run as language server. Empty: ./lumen in the workspace if there is one, else lumen from the PATH."
        },
        "lumen.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the language server. Without it only the colours are left."
        }
      }
    }
  }
}
