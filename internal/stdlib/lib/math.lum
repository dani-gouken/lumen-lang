// Numbers.
//
// Int and Float do not mix in arithmetic: convert with toFloat, or with
// one of floor, ceil, round and trunc, which say how the fraction is lost.

// --- Between Int and Float ---

pub extern fn toFloat(n: Int) -> Float;

// The largest whole number not above x: floor(2.7) is 2, floor(-2.7) is -3.
pub extern fn floor(x: Float) -> Int;

// The smallest whole number not below x: ceil(2.1) is 3.
pub extern fn ceil(x: Float) -> Int;

// The nearest whole number; halves go away from zero: round(2.5) is 3.
pub extern fn round(x: Float) -> Int;

// x without its fraction: trunc(-2.7) is -2.
pub extern fn trunc(x: Float) -> Int;

// --- Whole numbers ---

pub fn abs(n: Int) -> Int {
    if n < 0 { return -n; }
    return n;
}

pub fn min(a: Int, b: Int) -> Int {
    if a < b { return a; }
    return b;
}

pub fn max(a: Int, b: Int) -> Int {
    if a > b { return a; }
    return b;
}

// n, or the nearest of the two limits if it is outside them.
pub fn clamp(n: Int, low: Int, high: Int) -> Int {
    if n < low { return low; }
    if n > high { return high; }
    return n;
}

// -1, 0 or 1.
pub fn sign(n: Int) -> Int {
    if n < 0 { return -1; }
    if n > 0 { return 1; }
    return 0;
}

// base multiplied by itself exponent times. A negative exponent gives 0,
// except for a base of 1 or -1.
pub fn pow(base: Int, exponent: Int) -> Int {
    if exponent < 0 {
        if base == 1 { return 1; }
        if base == -1 {
            if exponent % 2 == 0 { return 1; }
            return -1;
        }
        return 0;
    }
    let result = 1;
    let factor = base;
    let left = exponent;
    // Squaring: about as many steps as the exponent has binary digits
    while left > 0 {
        if left % 2 == 1 { result *= factor; }
        left /= 2;
        if left > 0 { factor *= factor; }
    }
    return result;
}

// The greatest common divisor, never negative: gcd(12, 18) is 6.
pub fn gcd(a: Int, b: Int) -> Int {
    let x = abs(a);
    let y = abs(b);
    while y != 0 {
        let rest = x % y;
        x = y;
        y = rest;
    }
    return x;
}

// The least common multiple: lcm(4, 6) is 12.
pub fn lcm(a: Int, b: Int) -> Int {
    if a == 0 || b == 0 { return 0; }
    return abs(a / gcd(a, b) * b);
}

pub fn isEven(n: Int) -> Bool { return n % 2 == 0; }

pub fn isOdd(n: Int) -> Bool { return n % 2 != 0; }

// --- Numbers with a fraction ---

pub fn pi() -> Float { return 3.141592653589793; }

pub fn e() -> Float { return 2.718281828459045; }

pub fn fabs(x: Float) -> Float {
    if x < 0.0 { return -x; }
    return x;
}

pub fn fmin(a: Float, b: Float) -> Float {
    if a < b { return a; }
    return b;
}

pub fn fmax(a: Float, b: Float) -> Float {
    if a > b { return a; }
    return b;
}

// Fails for a negative number.
pub extern fn sqrt(x: Float) -> Float;

// base raised to exponent, which need not be whole: powf(2.0, 0.5).
pub extern fn powf(base: Float, exponent: Float) -> Float;

// e raised to x.
pub extern fn exp(x: Float) -> Float;

// The natural logarithm. Fails for zero and negative numbers.
pub extern fn log(x: Float) -> Float;

// Angles are in radians: a full turn is 2 * pi().
pub extern fn sin(x: Float) -> Float;
pub extern fn cos(x: Float) -> Float;
pub extern fn tan(x: Float) -> Float;

// The angle of the point (x, y), from -pi() to pi().
pub extern fn atan2(y: Float, x: Float) -> Float;

pub fn radians(degrees: Float) -> Float { return degrees * pi() / 180.0; }

pub fn degrees(radians: Float) -> Float { return radians * 180.0 / pi(); }
