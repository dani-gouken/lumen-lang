// The clock and the calendar.
//
// A moment is a number: milliseconds since the start of 1 January 1970,
// which is what `now` gives. A Date is that moment told the way people
// do, in some time zone.
//
//     let today = time.today();
//     println(today.format("dddd D MMMM YYYY"));       // Tuesday 13 October 2026
//     let due = today.plusDays(30);
//     println(due.iso(), today.daysUntil(due));

import std.strings;
import std.math;

// The time now, in milliseconds since 1 January 1970.
pub extern fn now() -> Int;

// Microseconds since the program started. For measuring how long
// something takes: unlike now, it never jumps when the clock is set.
pub extern fn ticks() -> Int;

// Waits that many milliseconds.
pub extern fn sleep(milliseconds: Int);

// The time now, in whole seconds since 1 January 1970.
pub fn seconds() -> Int {
    return now() / 1000;
}

// Lengths of time, in milliseconds: time.sleep(2 * time.second).
pub const second = 1000;
pub const minute = 60000;
pub const hour = 3600000;
pub const day = 86400000;
pub const week = 604800000;

// A stopwatch: start it, then ask how long ago that was.
pub struct Stopwatch {
    started: Int;
}

pub fn stopwatch() -> Stopwatch {
    return Stopwatch { started: ticks() };
}

impl Stopwatch {
    pub fn microseconds() -> Int { return ticks() - self.started; }

    pub fn milliseconds() -> Int { return self.microseconds() / 1000; }

    pub fn restart() { self.started = ticks(); }
}

// --- The calendar ---

pub enum Weekday { Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday }

impl Weekday {
    pub fn name() -> String {
        match self {
            case Weekday.Monday: { return "Monday"; }
            case Weekday.Tuesday: { return "Tuesday"; }
            case Weekday.Wednesday: { return "Wednesday"; }
            case Weekday.Thursday: { return "Thursday"; }
            case Weekday.Friday: { return "Friday"; }
            case Weekday.Saturday: { return "Saturday"; }
            case Weekday.Sunday: { return "Sunday"; }
        }
    }

    pub fn isWeekend() -> Bool {
        return self == Weekday.Saturday || self == Weekday.Sunday;
    }
}

const monthNames = "January February March April May June July August September October November December";

// The name of a month from its number, 1 for January.
pub fn monthName(month: Int) -> String {
    let names = strings.split(monthNames, " ");
    if month < 1 || month > 12 { panic("there is no month ${month}"); }
    return names[month - 1];
}

// How many days a month has: 29 for the February of a leap year.
pub fn daysIn(year: Int, month: Int) -> Int {
    // Day 0 of the next month is the last of this one
    return utc(moment([year, month + 1, 0, 0, 0, 0, 0], false)).day;
}

pub fn isLeapYear(year: Int) -> Bool {
    return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
}

// A moment, told as a date and a time of day in some time zone.
pub struct Date {
    year: Int;
    month: Int;             // 1 for January
    day: Int;               // of the month, from 1
    hour: Int;
    minute: Int;
    second: Int;
    millisecond: Int;
    weekday: Weekday;
    dayOfYear: Int;         // from 1
    offset: Int;            // minutes this time zone is ahead of UTC
}

// A moment as told in UTC, the time zone without daylight saving that
// the others are counted from.
pub fn utc(moment: Int) -> Date {
    return told(fields(moment, false));
}

// A moment as told where the program runs.
pub fn local(moment: Int) -> Date {
    return told(fields(moment, true));
}

// Now, as told where the program runs.
pub fn today() -> Date {
    return local(now());
}

// The start of a day, in UTC. Numbers out of range carry over: the 32nd
// of January is the 1st of February.
pub fn date(year: Int, month: Int, day: Int) -> Date {
    return utc(moment([year, month, day, 0, 0, 0, 0], false));
}

// A day and a time of day, in UTC.
pub fn dateTime(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int) -> Date {
    return utc(moment([year, month, day, hour, minute, second, 0], false));
}

// The date a text names, or null. It reads "2026-10-13", "2026-10-13 14:30",
// "2026-10-13T14:30:00Z", "2026-10-13T14:30:00+02:00" and the dates of
// e-mail and of web server logs. A text that names no time zone is taken
// as UTC, and the date that comes out is told in UTC whatever zone the
// text names.
pub fn parse(text: String) -> Date? {
    let moment = read(text);
    if moment == null { return null; }
    return utc(moment);
}

fn told(f: [Int]) -> Date {
    let days = [Weekday.Sunday, Weekday.Monday, Weekday.Tuesday, Weekday.Wednesday, Weekday.Thursday, Weekday.Friday, Weekday.Saturday];
    return Date {
        year: f[0], month: f[1], day: f[2],
        hour: f[3], minute: f[4], second: f[5], millisecond: f[6],
        weekday: days[f[7]], dayOfYear: f[8], offset: f[9],
    };
}

impl Date {
    // The moment, in milliseconds since 1 January 1970.
    pub fn timestamp() -> Int {
        let asUtc = moment([self.year, self.month, self.day, self.hour, self.minute, self.second, self.millisecond], false);
        return asUtc - self.offset * minute;
    }

    // The date that many milliseconds later (earlier, if negative), in the
    // same time zone.
    pub fn plus(milliseconds: Int) -> Date {
        return self.at(self.timestamp() + milliseconds);
    }

    // The same time of day that many days later. Unlike plus(n * time.day)
    // it stays at that time across a change to or from summer time.
    pub fn plusDays(days: Int) -> Date {
        return self.moved(0, days);
    }

    // The same day of the month that many months later. A day the month
    // does not have carries over: 31 January plus one month is in March.
    pub fn plusMonths(months: Int) -> Date {
        return self.moved(months, 0);
    }

    // Midnight of the same day.
    pub fn startOfDay() -> Date {
        let midnight = moment([self.year, self.month, self.day, 0, 0, 0, 0], false);
        return self.at(midnight - self.offset * minute);
    }

    // Whole days from this date to another, counting days of the calendar
    // and not lengths of 24 hours: from Monday 23:00 to Tuesday 01:00 is 1.
    pub fn daysUntil(other: Date) -> Int {
        let from = moment([self.year, self.month, self.day, 0, 0, 0, 0], false);
        let to = moment([other.year, other.month, other.day, 0, 0, 0, 0], false);
        return (to - from) / day;
    }

    pub fn isBefore(other: Date) -> Bool { return self.timestamp() < other.timestamp(); }

    pub fn isAfter(other: Date) -> Bool { return self.timestamp() > other.timestamp(); }

    // Whether both name the same day of the calendar.
    pub fn isSameDay(other: Date) -> Bool {
        return self.year == other.year && self.dayOfYear == other.dayOfYear;
    }

    // The date alone: 2026-10-13.
    pub fn iso() -> String {
        return self.format("YYYY-MM-DD");
    }

    // The date, the time and the time zone: 2026-10-13T14:30:00Z, or
    // ...+02:00 two hours ahead of UTC.
    pub fn isoTime() -> String {
        return self.format("YYYY-MM-DDTHH:mm:ssZ");
    }

    // The date written after a pattern. In it:
    //
    //     YYYY  2026        YY  26
    //     MMMM  October     MMM Oct     MM  10      M  10
    //     dddd  Tuesday     ddd Tue     DD  03      D  3
    //     HH    09          H   9       hh  09 (of 12)   h  9     A  AM
    //     mm    05          ss  07      SSS 042
    //     Z     +02:00, or Z for UTC
    //
    // Other characters are kept; letters to be kept go in brackets:
    // format("[on] D MMMM").
    pub fn format(pattern: String) -> String {
        let hour12 = (self.hour + 11) % 12 + 1;
        let out: [String] = [];
        let i = 0;
        while i < pattern.length {
            // The longest run of the same letter
            let letter = pattern[i];
            let run = 1;
            while i + run < pattern.length && pattern[i + run] == letter { run++; }

            if letter == "[" {
                let close = strings.indexOf(strings.from(pattern, i), "]") ?? pattern.length - i;
                push(out, strings.substring(pattern, i + 1, i + close));
                i += close + 1;
                continue;
            }

            let used = run;
            match letter {
                case "Y": {
                    if run >= 4 { push(out, pad(self.year, 4)); used = 4; }
                    else if run >= 2 { push(out, pad(self.year % 100, 2)); used = 2; }
                    else { push(out, letter); }
                }
                case "M": {
                    if run >= 4 { push(out, monthName(self.month)); used = 4; }
                    else if run == 3 { push(out, strings.first(monthName(self.month), 3)); }
                    else { push(out, pad(self.month, run)); }
                }
                case "d": {
                    if run >= 4 { push(out, self.weekday.name()); used = 4; }
                    else if run == 3 { push(out, strings.first(self.weekday.name(), 3)); }
                    else { push(out, strings.repeat(letter, run)); }
                }
                case "D": { used = math.min(run, 2); push(out, pad(self.day, used)); }
                case "H": { used = math.min(run, 2); push(out, pad(self.hour, used)); }
                case "h": { used = math.min(run, 2); push(out, pad(hour12, used)); }
                case "m": { used = math.min(run, 2); push(out, pad(self.minute, used)); }
                case "s": { used = math.min(run, 2); push(out, pad(self.second, used)); }
                case "S": {
                    if run >= 3 { push(out, pad(self.millisecond, 3)); used = 3; }
                    else { push(out, strings.repeat(letter, run)); }
                }
                case "A": {
                    used = 1;
                    if self.hour < 12 { push(out, "AM"); } else { push(out, "PM"); }
                }
                case "Z": { used = 1; push(out, self.zone()); }
                default: { push(out, strings.repeat(letter, run)); }
            }
            i += used;
        }
        return strings.join(out, "");
    }

    // The time zone as an offset: "Z" for UTC, "+02:00", "-05:30".
    pub fn zone() -> String {
        if self.offset == 0 { return "Z"; }
        let sign = "+";
        if self.offset < 0 { sign = "-"; }
        let minutes = math.abs(self.offset);
        return sign + pad(minutes / 60, 2) + ":" + pad(minutes % 60, 2);
    }

    // A moment told in the time zone of this date.
    fn at(moment: Int) -> Date {
        if self.followsTheMachine() { return local(moment); }
        return self.shifted(moment + self.offset * minute);
    }

    fn moved(months: Int, days: Int) -> Date {
        let f = [self.year, self.month + months, self.day + days, self.hour, self.minute, self.second, self.millisecond];
        if self.followsTheMachine() { return local(moment(f, true)); }
        return self.shifted(moment(f, false));
    }

    // Whether this date is told in the time zone of the machine, whose
    // offset changes with the seasons, and not at a fixed offset.
    fn followsTheMachine() -> Bool {
        return self.offset != 0 && local(self.timestamp()).offset == self.offset;
    }

    // The date whose clock reads what UTC reads at `moment`, at the
    // offset of this one.
    fn shifted(moment: Int) -> Date {
        let out = utc(moment);
        out.offset = self.offset;
        return out;
    }
}

fn pad(n: Int, width: Int) -> String {
    let digits = toString(n);
    return strings.repeat("0", math.max(0, width - digits.length)) + digits;
}

extern fn fields(moment: Int, isLocal: Bool) -> [Int];
extern fn moment(fields: [Int], isLocal: Bool) -> Int;
extern fn read(text: String) -> Int?;
