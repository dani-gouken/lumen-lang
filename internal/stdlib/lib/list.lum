// A list: an array wrapped in a struct, with what is done to arrays as
// methods, so that calls read from left to right:
//
//     let names = list.of(["ada", "linus"]);
//     names.add("grace");
//     names.filter(n -> n.len() > 3).size()

import std.arrays;
import std.ops.{Iterable, Indexed, IndexedSet};

pub struct List<T> {
    items: [T];
}

// A list goes where an array does: `for item in names`, `names[0]`,
// `names[0] = "ada";`. As with an array, a position the list does not
// have stops the program; `get` gives null instead.
impl<T> Iterable<T> for List<T> {
    fn iterate() -> [T] {
        return self.items;
    }
}

impl<T> Indexed<Int, T> for List<T> {
    fn at(key: Int) -> T {
        return self.items[key];
    }
}

impl<T> IndexedSet<Int, T> for List<T> {
    fn put(key: Int, value: T) {
        self.items[key] = value;
    }
}

// An empty list. Say what it holds: list.empty<Int>().
pub fn empty<T>() -> List<T> {
    return List<T> { items: [] };
}

// A list of the items of an array. The list has its own copy.
pub fn of<T>(items: [T]) -> List<T> {
    return List<T> { items: items.copy() };
}

impl<T> List<T> {
    pub fn size() -> Int {
        return self.items.len();
    }

    pub fn isEmpty() -> Bool {
        return self.items.len() == 0;
    }

    // --- Changing the list ---

    pub fn add(value: T) {
        self.items.push(value);
    }

    pub fn addAll(values: [T]) {
        for value in values {
            self.items.push(value);
        }
    }

    // Replaces the item at `index`. Fails if there is none there.
    pub fn set(index: Int, value: T) {
        self.items[index] = value;
    }

    // Puts `value` at `index`, moving the items from there on up. An index
    // at or past the end adds it at the end; a negative one changes nothing.
    pub fn insert(index: Int, value: T) {
        self.items.insertAt(index, value);
    }

    // Takes out the item at `index` and returns it, or null if there is
    // none there.
    pub fn removeAt(index: Int) -> T? {
        return self.items.removeAt(index);
    }

    // Takes out the last item and returns it, or null for an empty list.
    pub fn pop() -> T? {
        return self.items.pop();
    }

    pub fn clear() {
        self.items.clear();
    }

    // Puts the list itself in order; see items -> items.sorted().
    pub fn sort(before: fn(T, T) -> Bool) {
        self.items = self.items.sorted(before);
    }

    // --- Reading ---

    // The item at `index`, or null if there is none there.
    pub fn get(index: Int) -> T? {
        return self.items.at(index);
    }

    pub fn first() -> T? {
        return self.items.first();
    }

    pub fn last() -> T? {
        return self.items.last();
    }

    pub fn find(wanted: fn(T) -> Bool) -> T? {
        return self.items.find(wanted);
    }

    pub fn findIndex(wanted: fn(T) -> Bool) -> Int? {
        return self.items.findIndex(wanted);
    }

    // Whether an item is equal to `value`; see items -> items.indexOf().
    pub fn contains(value: T) -> Bool {
        return self.items.contains(value);
    }

    pub fn indexOf(value: T) -> Int? {
        return self.items.indexOf(value);
    }

    pub fn any(wanted: fn(T) -> Bool) -> Bool {
        return self.items.any(wanted);
    }

    pub fn all(wanted: fn(T) -> Bool) -> Bool {
        return self.items.all(wanted);
    }

    pub fn count(wanted: fn(T) -> Bool) -> Int {
        return self.items.count(wanted);
    }

    // An array of the items; changing it does not change the list.
    pub fn toArray() -> [T] {
        return self.items.copy();
    }

    // --- New lists from this one ---

    pub fn map<U>(convert: fn(T) -> U) -> List<U> {
        let out = empty<U>();

        for item in self.items {
            out.add(convert(item));
        }

        return out;
    }

    pub fn filter(wanted: fn(T) -> Bool) -> List<T> {
        return List<T> { items: self.items.filter(wanted) };
    }

    pub fn sorted(before: fn(T, T) -> Bool) -> List<T> {
        return List<T> { items: self.items.sorted(before) };
    }

    pub fn reversed() -> List<T> {
        return List<T> { items: self.items.reversed() };
    }

    pub fn slice(from: Int, to: Int) -> List<T> {
        return List<T> { items: self.items.slice(from, to) };
    }

    pub fn fold<A>(start: A, combine: fn(A, T) -> A) -> A {
        let result = start;

        for item in self.items {
            result = combine(result, item);
        }

        return result;
    }

    pub fn each(action: fn(T) -> Void) {
        for item in self.items {
            action(item);
        }
    }
}
