// A dictionary: values found by a text key.
//
//     let ages = dict.empty<Int>();
//     ages.set("ada", 36);
//     ages.get("ada") ?? 0
//
// It is a hash table, so finding a key takes about the same time however
// many there are. Keys come back in the order they were first set.

import std.strings;
import std.ops.{Iterable, Indexed, IndexedSet};

struct Entry<V> {
    key: String;
    value: V;
    live: Bool;       // false once removed
}

pub struct Dict<V> {
    entries: [Entry<V>];    // in the order the keys were set
    buckets: [[Int]];       // positions in entries, by hash of the key
    count: Int;
}

// An empty dictionary. Say what it holds: dict.empty<Int>().
pub fn empty<V>() -> Dict<V> {
    return Dict<V> { entries: [], buckets: newBuckets(8), count: 0 };
}

fn newBuckets(size: Int) -> [[Int]] {
    let buckets: [[Int]] = [];
    let i = 0;
    while i < size {
        let bucket: [Int] = [];
        push(buckets, bucket);
        i++;
    }
    return buckets;
}

// A dictionary takes brackets and loops: `ages["ada"]` is what `get`
// gives, a value or null; `ages["ada"] = 36;` is `set`; and
// `for name in ages` goes through the keys.
impl<V> Iterable<String> for Dict<V> {
    fn iterate() -> [String] { return self.keys(); }
}

impl<V> Indexed<String, V?> for Dict<V> {
    fn at(key: String) -> V? { return self.get(key); }
}

impl<V> IndexedSet<String, V> for Dict<V> {
    fn put(key: String, value: V) { self.set(key, value); }
}

impl<V> Dict<V> {
    pub fn size() -> Int { return self.count; }

    pub fn isEmpty() -> Bool { return self.count == 0; }

    // Sets the value of a key, replacing the one it had.
    pub fn set(key: String, value: V) {
        let at = self.position(key);
        if at != null {
            self.entries[at].value = value;
            return;
        }
        if self.entries.length >= self.buckets.length * 2 {
            self.grow();
        }
        push(self.entries, Entry<V> { key: key, value: value, live: true });
        push(self.bucket(key), self.entries.length - 1);
        self.count++;
    }

    // The value of a key, or null if it has none.
    pub fn get(key: String) -> V? {
        let at = self.position(key);
        if at == null { return null; }
        return self.entries[at].value;
    }

    // The value of a key, or `fallback` if it has none.
    pub fn getOr(key: String, fallback: V) -> V {
        return self.get(key) ?? fallback;
    }

    // Changes the value of a key to what a function makes of it, the
    // function being given `start` if the key has none. Counting:
    // counts.update(word, 0, n -> n + 1).
    pub fn update(key: String, start: V, change: fn(V) -> V) {
        self.set(key, change(self.get(key) ?? start));
    }

    pub fn has(key: String) -> Bool {
        return self.position(key) != null;
    }

    // Removes a key. Returns whether it was there.
    pub fn remove(key: String) -> Bool {
        let at = self.position(key);
        if at == null { return false; }
        self.entries[at].live = false;
        self.count--;
        return true;
    }

    // The keys, in the order they were first set.
    pub fn keys() -> [String] {
        let out: [String] = [];
        for entry in self.entries {
            if entry.live { push(out, entry.key); }
        }
        return out;
    }

    // The values, in the order of their keys.
    pub fn values() -> [V] {
        let out: [V] = [];
        for entry in self.entries {
            if entry.live { push(out, entry.value); }
        }
        return out;
    }

    // Each key with its value, in the order of the keys.
    //
    //     for (name, age) in ages.entries() { ... }
    pub fn entries() -> [(String, V)] {
        let out: [(String, V)] = [];
        for entry in self.entries {
            if entry.live { push(out, (entry.key, entry.value)); }
        }
        return out;
    }

    // The keys in alphabetical order.
    pub fn sortedKeys() -> [String] {
        let keys = self.keys();
        // Insertion sort: std.arrays builds on this module, not the reverse
        let i = 1;
        while i < keys.length {
            let key = keys[i];
            let j = i - 1;
            while j >= 0 && keys[j] > key {
                keys[j + 1] = keys[j];
                j--;
            }
            keys[j + 1] = key;
            i++;
        }
        return keys;
    }

    // Calls the function with each key and its value.
    pub fn each(action: fn(String, V) -> Void) {
        for entry in self.entries {
            if entry.live { action(entry.key, entry.value); }
        }
    }

    // Where the key is in entries, or null.
    fn position(key: String) -> Int? {
        for at in self.bucket(key) {
            let entry = self.entries[at];
            if entry.live && entry.key == key { return at; }
        }
        return null;
    }

    fn bucket(key: String) -> [Int] {
        return self.buckets[strings.hash(key) % self.buckets.length];
    }

    // Twice the buckets, and the removed entries dropped.
    fn grow() {
        let kept: [Entry<V>] = [];
        for entry in self.entries {
            if entry.live { push(kept, entry); }
        }
        self.entries = kept;
        self.buckets = newBuckets(self.buckets.length * 2);
        for at, entry in self.entries {
            push(self.bucket(entry.key), at);
        }
    }
}
