// Paths: the names of files and folders, taken apart and put together.
//
// Nothing here touches the disk; see std.fs for that. The separator is
// the one of the system the program runs on.

import std.strings;
import std.arrays;

// "/" on Linux and macOS, "\" on Windows.
pub extern fn separator() -> String;

extern fn joined(parts: [String]) -> String;

// The parts put together with the separator, tidied: join(["a", "b/", "../c.txt"])
// is "a/c.txt".
pub fn join(parts: [String]) -> String {
    return joined(parts);
}

// A name inside a folder: path.inside("notes", "todo.txt") is "notes/todo.txt".
pub fn inside(folder: String, name: String) -> String {
    return joined([folder, name]);
}

// The last part: "notes/todo.txt" gives "todo.txt".
pub extern fn base(path: String) -> String;

// All but the last part: "notes/todo.txt" gives "notes".
pub extern fn dir(path: String) -> String;

// The extension with its dot, ".txt", or "" if there is none.
pub extern fn extension(path: String) -> String;

// The shortest path that means the same: "a//b/../c" gives "a/c".
pub extern fn clean(path: String) -> String;

pub extern fn isAbsolute(path: String) -> Bool;

// The path from the root of the disk, relative ones being taken from the
// folder the program runs in.
pub extern fn absolute(path: String) -> String;

// Whether a name fits a pattern where * stands for any characters and ?
// for one: path.matches("*.txt", "todo.txt").
pub extern fn matches(pattern: String, name: String) -> Bool;

// The last part without its extension: "notes/todo.txt" gives "todo".
pub fn stem(path: String) -> String {
    let name = base(path);
    return strings.first(name, strings.len(name) - strings.len(extension(name)));
}

// The same path with another extension: withExtension("a/b.md", ".html").
pub fn withExtension(path: String, extension: String) -> String {
    let folder = dir(path);
    let name = stem(path) + extension;

    if folder == "." && !strings.startsWith(path, ".") {
        return name;
    }

    return inside(folder, name);
}

// The names along the path: "a/b/c.txt" gives ["a", "b", "c.txt"].
pub fn parts(path: String) -> [String] {
    let wanted = fn(part: String) -> Bool {
        return part != "";
    };

    return clean(path) |> strings.split(separator()) |> arrays.filter(wanted);
}
